    "@astrojs/mdx": "^4.3.13",
    "@astrojs/netlify": "^6.6.4",
    "@astrojs/tailwind": "^6.0.2",
    "@astrojs/vue": "^5.1.4",
    "astro": "^5.17.1",
    "astro-i18n": "^2.2.4",
    "dayjs": "^1.11.19",
    "gsap": "^3.14.2",
    "lodash-es": "^4.17.23",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "viewerjs": "^1.11.7",
    "vue": "^3.5.27"
  },
  "devDependencies": {
    "@shikijs/twoslash": "^3.22.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.2.1",
    "esbuild": "^0.27.3",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^3.4.19"
