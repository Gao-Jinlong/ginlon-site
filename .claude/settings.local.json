{
  "permissions": {
    "allow": [
      "mcp__sentrux__scan",
      "mcp__sentrux__health",
      "mcp__sentrux__dsm",
      "mcp__sentrux__git_stats",
      "Bash(pnpm build:*)",
      "Bash(git log:*)",
      "Bash(git diff-tree:*)",
      "Bash(find docs:*)",
      "Bash(pnpm add:*)",
      "WebFetch(domain:docs.astro.build)",
      "WebFetch(domain:docs.nestjs.com)",
      "WebSearch",
      "WebFetch(domain:nestjs.bootcss.com)",
      "WebFetch(domain:www.jsdocs.io)",
      "Bash(pnpm dev *)",
      "Bash(Select-String -Pattern \"error|Error|ERROR|warn|ready\")",
      "Bash(Select-Object -First 5)",
      "Bash(timeout 15)"
    ],
    "defaultMode": "bypassPermissions"
  }
}
