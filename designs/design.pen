                          "id": "K6JSQU",
                          "name": "结构说明",
                          "fill": "#6B756F",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "优先 fill_container · fit_content · gap",
                          "lineHeight": 1.6,
                          "fontFamily": "Noto Serif SC",
                          "fontSize": 14,
