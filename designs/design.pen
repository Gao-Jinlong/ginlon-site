                      "name": "引文",
                      "fill": "$text-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "模型决定能力的上限，Harness 决定你能稳定拿到其中的多少。",
                      "lineHeight": 1.8,
                      "fontFamily": "$font-serif",
                      "fontSize": 16,
                      "fontWeight": "normal",
                      "fontStyle": "italic"
                    }
                  ]
