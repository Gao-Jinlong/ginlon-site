---
import RecentPosts from '../components/RecentPosts.astro'
import Main from './Main.astro'
import { Image } from 'astro:assets'
import { getBlogs } from '../utils/getBlogs'
import { t } from 'astro-i18n'
import TableOfContents from '../components/TableOfContents.astro'
import { dayjs, format } from '../utils/dayjs'

const { title, subtitle, poster, posterDescription, createdAt, lastModified } =
  Astro.props.frontmatter

const blogs = await getBlogs()
const otherBlogs = blogs.filter(({ data }) => {
  return title !== data.title && !data.draft
})

// 获取文章中的所有标题
const headings = await Astro.props.headings
---

<Main pageTitle={title}>
  <article class="blog-article">
    <div class="article-container">
      <div class="article-main">
        <header class="article-header">
          <div class="header-text">
            <h1 class="article-title">{title}</h1>
            {subtitle && <h2 class="article-subtitle">{subtitle}</h2>}
            <div class="article-meta">
              <time class="article-date">
                {t('blogs.createdAt')}: {dayjs(createdAt).format(format)}
              </time>
            </div>
          </div>
          {
            poster && (
              <div class="cover-container">
                <div class="cover-image">
                  <Image
                    src={`${poster}`}
                    alt="Poster image"
                    width={1024}
                    height={480}
                    class="poster-image"
                  />
                </div>

                {posterDescription && (
                  <div class="cover-description">{posterDescription}</div>
                )}
              </div>
            )
          }
        </header>

        <div class="content-wrapper">
          <div class="article-content prose dark:prose-invert">
            <slot />
            {
              lastModified && (
                <div class="last-modified">
                  {t('blogs.lastModified')}:{dayjs(lastModified).format(format)}
                </div>
              )
            }
          </div>
        </div>

        <footer class="article-footer">
          <RecentPosts blogs={otherBlogs} />
        </footer>
      </div>
    </div>

    {headings.length > 0 && <TableOfContents headings={headings} />}
  </article>
</Main>

<style>
  .blog-article {
    @apply relative mx-auto max-w-4xl;
  }

  .article-container {
    @apply relative flex gap-8;
  }

  .article-main {
    @apply mt-6 w-full rounded-lg border border-gray-100 bg-white/90 p-6 shadow-sm backdrop-blur-sm dark:border-gray-800 dark:bg-gray-900/90;
  }

  .article-header {
    @apply mb-6;
  }

  .header-text {
    @apply mb-6 border-b border-gray-100 pb-4 dark:border-gray-800;
  }

  .article-title {
    @apply text-3xl font-bold leading-tight text-gray-900 dark:text-gray-100;
  }

  .article-subtitle {
    @apply mt-2 text-xl font-normal leading-relaxed text-gray-600 dark:text-gray-400;
  }

  .article-meta {
    @apply mt-2 flex items-center gap-4 text-sm text-gray-500 dark:text-gray-500;
  }

  .article-date {
    @apply flex items-center gap-1;
  }

  .cover-container {
    @apply overflow-hidden rounded-sm border border-gray-100 dark:border-gray-800;
  }

  .cover-image {
    @apply relative h-64 w-full overflow-hidden bg-gray-800;
  }

  .poster-image {
    @apply h-full w-full object-cover transition-all duration-300 hover:scale-105;
  }

  .cover-description {
    @apply border-t border-gray-100 bg-white/50 p-3 text-sm text-gray-600 dark:border-gray-800 dark:bg-gray-900/50 dark:text-gray-400;
  }

  .content-wrapper {
    @apply mt-8;
  }

  .article-content {
    @apply prose prose-lg mx-auto w-full text-[1rem] dark:prose-invert;
  }

  .last-modified {
    @apply mt-8 text-right text-sm text-gray-500 dark:text-gray-500;
  }

  .article-footer {
    @apply mt-12;
  }

  /* 移动端适配 */
  @media (max-width: 768px) {
    .article-main {
      @apply p-4;
    }

    .header-text {
      @apply mb-4 pb-3;
    }

    .article-title {
      @apply text-2xl;
    }

    .article-subtitle {
      @apply text-lg;
    }

    .article-meta {
      @apply mt-3;
    }

    .cover-image {
      @apply h-48;
    }

    .cover-description {
      @apply p-2 text-xs;
    }

    .content-wrapper {
      @apply mt-6;
    }
  }
</style>
