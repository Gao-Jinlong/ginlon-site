---
import { siteConfig } from '../data/site';
import type { PageMeta } from '../types/seo';
import MetadataRow from '../components/MetadataRow.astro';
import PageContainer from '../components/PageContainer.astro';
import RecentPosts from '../components/RecentPosts.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { getLocaleFromUrl, useTranslations } from '../i18n/utils';
import { dayjs, format } from '../utils/dayjs';
import { getBlogs } from '../utils/getBlogs';
import Main from './Main.astro';

type Heading = {
  depth: number;
  slug: string;
  text: string;
};

type Frontmatter = {
  title: string;
  subtitle?: string;
  description?: string;
  poster?: string;
  posterDescription?: string;
  createdAt: string;
  lastModified?: string | Date;
  tags?: string[];
  permalink?: string;
};

type Props = {
  currentSlug?: string;
  frontmatter: Frontmatter;
  headings?: Heading[];
  pageMeta?: Partial<PageMeta>;
};

const { currentSlug, frontmatter, headings = [], pageMeta } = Astro.props as Props;
const {
  createdAt,
  description,
  lastModified,
  permalink,
  poster,
  posterDescription,
  subtitle,
  tags,
  title,
} = frontmatter;

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const blogs = await getBlogs(locale);
const otherBlogs = blogs.filter(({ data }) => {
  return (currentSlug ?? permalink ?? title) !== data.permalink && !data.draft;
});

const filteredHeadings = headings.filter((heading) => heading.depth <= 4);
const summary = description ?? subtitle;
const publishedLabel = dayjs(createdAt, locale).format(format);
const publishedTime = new Date(createdAt).toISOString();
const lastModifiedValue =
  typeof lastModified === 'string' ? lastModified : lastModified?.toISOString();
const lastModifiedLabel = lastModifiedValue
  ? dayjs(lastModifiedValue, locale).format(format)
  : undefined;
const articleMeta = {
  title: `${title} | ${siteConfig.name}`,
  description: summary || siteConfig[locale].description,
  ogType: 'article',
  ogImage: siteConfig.articleOgImage,
  ...(tags ? { tags } : {}),
  ...(publishedTime ? { publishedTime } : {}),
  ...(lastModifiedValue ? { modifiedTime: lastModifiedValue } : {}),
} satisfies Partial<PageMeta>;
const mainProps = {
  pageTitle: title,
  pageMeta: pageMeta ? { ...articleMeta, ...pageMeta } : articleMeta,
};
---

<Main {...mainProps}>
  <PageContainer class="article-page">
    <article class="article-shell">
      <header class="article-hero">
        <div class="article-hero-copy">
          <p class="article-eyebrow">WRITING</p>
          <h1 class="article-title">{title}</h1>
          {summary && <p class="article-summary">{summary}</p>}
          <div class="article-meta-group">
            <MetadataRow date={publishedLabel} tags={tags} />
            {
              lastModifiedLabel && (
                <p class="article-updated">
                  {t('blogs.lastModified')}: {lastModifiedLabel}
                </p>
              )
            }
          </div>
        </div>

        {
          poster && (
            <figure class="article-cover">
              <img
                src={poster}
                alt={posterDescription ?? title}
                class="article-cover-image"
                loading="eager"
              />
              {posterDescription && <figcaption>{posterDescription}</figcaption>}
            </figure>
          )
        }
      </header>

      <div class="article-layout">
        <div class="article-main-column">
          {filteredHeadings.length > 0 && (
            <div class="article-toc-mobile">
              <TableOfContents headings={filteredHeadings} />
            </div>
          )}

          <div class="article-body-surface">
            <div class="article-content">
              <slot />
            </div>

            {
              lastModifiedLabel && (
                <footer class="article-body-footer">
                  <span>{t('blogs.lastModified')}</span>
                  <time>{lastModifiedLabel}</time>
                </footer>
              )
            }
          </div>
        </div>

        {filteredHeadings.length > 0 && (
          <aside class="article-sidebar" aria-label={t('blogs.tableOfContents')}>
            <TableOfContents headings={filteredHeadings} />
          </aside>
        )}
      </div>

      {otherBlogs.length > 0 && (
        <footer class="article-footer">
          <RecentPosts blogs={otherBlogs} />
        </footer>
      )}
    </article>
  </PageContainer>
</Main>

<style>
  .article-page {
    padding-top: 2rem;
    padding-bottom: 2.5rem;
  }

  .article-shell {
    display: grid;
    gap: 1.5rem;
  }

  .article-hero {
    display: grid;
    gap: 1.5rem;
    border: 1px solid var(--surface-border);
    background: var(--surface-bg-strong);
    padding: 1.3rem;
    box-shadow: var(--shadow-soft);
  }

  .article-hero-copy {
    display: grid;
    gap: 1rem;
    max-width: 46rem;
  }

  .article-eyebrow {
    margin: 0;
    color: var(--accent);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .article-title {
    margin: 0;
    color: var(--text-strong);
    font-size: clamp(2.2rem, 1.4rem + 2.5vw, 4.2rem);
    line-height: 0.96;
    letter-spacing: -0.04em;
  }

  .article-summary {
    margin: 0;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.9;
    max-width: 42rem;
  }

  .article-meta-group {
    display: grid;
    gap: 0.65rem;
  }

  .article-updated {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .article-cover {
    display: grid;
    gap: 0.7rem;
    margin: 0;
  }

  .article-cover-image {
    display: block;
    width: 100%;
    max-height: 34rem;
    object-fit: cover;
    border: 1px solid var(--surface-border);
    background: linear-gradient(135deg, rgba(31, 118, 103, 0.08), rgba(114, 140, 168, 0.06));
  }

  .article-cover figcaption {
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .article-layout {
    display: grid;
    gap: 1.5rem;
  }

  .article-main-column {
    display: grid;
    gap: 1rem;
  }

  .article-toc-mobile {
    display: block;
  }

  .article-sidebar {
    display: none;
  }

  .article-body-surface {
    border: 1px solid var(--surface-border);
    background: var(--surface-bg-strong);
    padding: 1.2rem;
    box-shadow: var(--shadow-soft);
  }

  .article-content {
    max-width: 46rem;
    margin: 0 auto;
    color: var(--text-strong);
    font-size: 1rem;
    line-height: 1.9;
  }

  .article-content :global(h2),
  .article-content :global(h3),
  .article-content :global(h4),
  .article-content :global(h5) {
    margin-top: 2.6rem;
    margin-bottom: 0.9rem;
    color: var(--text-strong);
    line-height: 1.25;
    letter-spacing: -0.03em;
  }

  .article-content :global(h2) {
    font-size: clamp(1.6rem, 1.2rem + 1vw, 2.25rem);
  }

  .article-content :global(h3) {
    font-size: clamp(1.3rem, 1.15rem + 0.6vw, 1.7rem);
  }

  .article-content :global(p),
  .article-content :global(ul),
  .article-content :global(ol),
  .article-content :global(blockquote),
  .article-content :global(pre),
  .article-content :global(table) {
    margin-block: 1rem;
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    padding-left: 1.4rem;
  }

  .article-content :global(li) {
    margin-block: 0.45rem;
  }

  .article-content :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .article-content :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .article-content :global(blockquote) {
    border-left: 3px solid var(--accent);
    margin-inline: 0;
    padding: 0.2rem 0 0.2rem 1rem;
    color: var(--text-muted);
  }

  .article-content :global(code):not(:global(pre code)) {
    border: 1px solid var(--surface-border);
    background: var(--accent-soft);
    padding: 0.15rem 0.35rem;
    font-size: 0.9em;
  }

  .article-content :global(pre) {
    overflow-x: auto;
    border: 1px solid var(--surface-border);
    background: rgba(15, 23, 42, 0.96);
    padding: 1rem;
    color: #f8fafc;
  }

  .article-content :global(pre code) {
    display: block;
    min-width: max-content;
    background: transparent;
    padding: 0;
    color: inherit;
  }

  .article-content :global(hr) {
    border: 0;
    border-top: 1px solid var(--surface-border);
    margin: 2.5rem 0;
  }

  .article-body-footer {
    display: flex;
    justify-content: flex-end;
    gap: 0.45rem;
    border-top: 1px solid var(--surface-border);
    margin-top: 2rem;
    padding-top: 1rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .article-footer {
    margin-top: 0.5rem;
  }

  @media (min-width: 1024px) {
    .article-layout {
      grid-template-columns: minmax(0, 1fr) 17rem;
      align-items: start;
    }

    .article-toc-mobile {
      display: none;
    }

    .article-sidebar {
      display: block;
    }
  }

  @media (min-width: 1200px) {
    .article-hero {
      grid-template-columns: minmax(0, 1fr) minmax(20rem, 28rem);
      align-items: start;
      padding: 1.6rem;
    }

    .article-body-surface {
      padding: 1.6rem;
    }
  }

  @media (max-width: 767px) {
    .article-page {
      padding-top: 1rem;
    }

    .article-hero,
    .article-body-surface {
      padding: 1rem;
    }

    .article-summary,
    .article-content {
      font-size: 0.97rem;
    }
  }
</style>
