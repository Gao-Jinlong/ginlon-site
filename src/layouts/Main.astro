---
import 'viewerjs/dist/viewer.css';

import Footer from '../components/Footer.astro';
import GridBackground from '../components/GridBackground.astro';
import Head from '../components/Head.astro';
import NavigationBar from '../components/NavigationBar.astro';
import { siteConfig } from '../data/site';
import { getLocaleFromUrl, useTranslations } from '../i18n/utils';
import type { PageMeta } from '../types/seo';
import { buildCanonicalUrl, buildLocaleAlternates, mergePageMeta } from '../utils/seo';
import '../styles/styles.css';

type Props = {
  pageTitle?: string;
  pageMeta?: Partial<PageMeta>;
};

const { pageMeta, pageTitle } = Astro.props as Props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const localizedSite = siteConfig[locale];

const defaultMeta: PageMeta = {
  title: localizedSite.title,
  description: localizedSite.description,
  canonical: buildCanonicalUrl(siteConfig.url, Astro.url.pathname),
  alternates: buildLocaleAlternates(siteConfig.url, Astro.url.pathname),
  ogImage: siteConfig.defaultOgImage,
  ogType: 'website',
  keywords: t('seo.keywords'),
};

const legacyMeta = pageTitle
  ? {
      title: `${pageTitle} | ${siteConfig.name}`,
    }
  : {};

const resolvedMeta = mergePageMeta(defaultMeta, {
  ...legacyMeta,
  ...pageMeta,
});
---

<html lang={locale}>
  <Head pageMeta={resolvedMeta} />

  <body class="site-body">
    <GridBackground />
    <div class="site-glow site-glow-left"></div>
    <div class="site-glow site-glow-right"></div>

    <div class="site-shell">
      <NavigationBar />

      <main class="site-main">
        <slot />
      </main>

      <Footer />
    </div>

    <script>
      import gsap from 'gsap';

      document.addEventListener('astro:page-load', () => {
        gsap.from('.animate', {
          opacity: 0,
          y: 20,
          duration: 1,
          stagger: 0.2,
          ease: 'power2.out',
        });
      });
    </script>

    <script>
      import { useImageViewer } from './useImageViewer';

      useImageViewer({
        options: {},
      });
    </script>
  </body>
</html>

<style>
  .site-body {
    min-height: 100vh;
    overflow-x: hidden;
    background: var(--page-bg);
    color: var(--text-strong);
  }

  .site-shell {
    position: relative;
    z-index: 1;
    min-height: 100vh;
  }

  .site-main {
    position: relative;
    padding: 1rem 0 3.5rem;
  }

  .site-glow {
    pointer-events: none;
    position: fixed;
    z-index: 0;
    border-radius: 999px;
    filter: blur(80px);
    opacity: 0.55;
  }

  .site-glow-left {
    top: -4rem;
    left: -8rem;
    width: 18rem;
    height: 18rem;
    background: rgba(31, 118, 103, 0.18);
  }

  .site-glow-right {
    top: 4rem;
    right: -6rem;
    width: 16rem;
    height: 16rem;
    background: rgba(114, 140, 168, 0.14);
  }

  @media (min-width: 768px) {
    .site-main {
      padding-top: 1.25rem;
      padding-bottom: 5rem;
    }

    .site-glow-left {
      width: 24rem;
      height: 24rem;
    }

    .site-glow-right {
      width: 22rem;
      height: 22rem;
    }
  }
</style>
