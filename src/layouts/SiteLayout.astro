---
import { ClientRouter } from 'astro:transitions';
import SiteFooter from '../components/site/SiteFooter.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import BackToTop from '../components/site/BackToTop.astro';
import { siteConfig } from '../data/site';
import '../styles/styles.css';
import 'katex/dist/katex.min.css';
import type { PageMeta } from '../types/seo';
import { buildCanonicalUrl, buildLocaleAlternates, mergePageMeta } from '../utils/seo';

type Props = {
  pageTitle?: string;
  pageMeta?: Partial<PageMeta>;
  hideFooter?: boolean;
};

const { pageMeta, pageTitle, hideFooter = false } = Astro.props as Props;
const localizedSite = siteConfig.zh;

const defaultMeta: PageMeta = {
  title: localizedSite.title,
  description: localizedSite.description,
  canonical: buildCanonicalUrl(siteConfig.url, Astro.url.pathname),
  alternates: buildLocaleAlternates(siteConfig.url, Astro.url.pathname),
  ogImage: siteConfig.defaultOgImage,
  ogType: 'website',
};

const resolvedMeta = mergePageMeta(defaultMeta, {
  ...(pageTitle ? { title: `${pageTitle} | ${siteConfig.name}` } : {}),
  ...pageMeta,
});
---

<html lang="zh" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <title>{resolvedMeta.title}</title>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <ClientRouter />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Noto+Serif+SC:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    {resolvedMeta.canonical && <link rel="canonical" href={resolvedMeta.canonical} />}
    {resolvedMeta.alternates?.map((link) => (
      <link rel="alternate" hreflang={link.hrefLang} href={link.href} />
    ))}

    <meta name="author" content={siteConfig.name} />
    <meta name="description" content={resolvedMeta.description} />
    {resolvedMeta.keywords && <meta name="keywords" content={resolvedMeta.keywords} />}
    {resolvedMeta.robots && <meta name="robots" content={resolvedMeta.robots} />}

    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:type" content={resolvedMeta.ogType ?? 'website'} />
    {resolvedMeta.canonical && <meta property="og:url" content={resolvedMeta.canonical} />}
    <meta property="og:title" content={resolvedMeta.title} />
    <meta property="og:description" content={resolvedMeta.description} />
    {resolvedMeta.ogImage && <meta property="og:image" content={resolvedMeta.ogImage} />}
    {resolvedMeta.publishedTime && <meta property="article:published_time" content={resolvedMeta.publishedTime} />}
    {resolvedMeta.modifiedTime && <meta property="article:modified_time" content={resolvedMeta.modifiedTime} />}
    {resolvedMeta.tags?.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content="summary_large_image" />
    {resolvedMeta.canonical && <meta name="twitter:url" content={resolvedMeta.canonical} />}
    <meta name="twitter:title" content={resolvedMeta.title} />
    <meta name="twitter:description" content={resolvedMeta.description} />
    {resolvedMeta.ogImage && <meta name="twitter:image" content={resolvedMeta.ogImage} />}

    <!-- KaTeX auto-render -->
    <script
      defer
      src="https://cdn.jsdelivr.net/npm/katex@0.16.45/dist/contrib/auto-render.min.js"
      integrity="sha384-eOVlD+hIQ2C7h87SPhKqGLM7fXpMHqRrCqQzLdD16l4d8rL5JhH7S9K0y7TGLh"
      crossorigin="anonymous"
    ></script>
    <script defer is:inline>
      // KaTeX auto-render on DOMContentLoaded
      document.addEventListener('DOMContentLoaded', function() {
        if (window.renderMathInElement) {
          renderMathInElement(document.body, {
            delimiters: [
              {left: '$$', right: '$$', display: true},
              {left: '$', right: '$', display: false},
              {left: '\\(', right: '\\)', display: false},
              {left: '\\[', right: '\\]', display: true}
            ],
            throwOnError: false
          });
        }
      });
    </script>

    <script is:inline type="text/javascript">
      (function (c, l, a, r, i, t, y) {
        c[a] =
          c[a] ||
          function () {
            (c[a].q = c[a].q || []).push(arguments);
          };
        t = l.createElement(r);
        t.async = 1;
        t.src = 'https://www.clarity.ms/tag/' + i;
        y = l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t, y);
      })(window, document, 'clarity', 'script', 'm0nmyla1jj');
    </script>
  </head>

  <body class="editorial-body">
    <a class="skip-link" href="#main-content">
      跳到正文
    </a>

    <div class="editorial-shell">
      <SiteHeader />
      <main id="main-content" class="editorial-main">
        <slot />
      </main>
      {!hideFooter && <SiteFooter />}
      <BackToTop />
    </div>
  </body>
</html>

<style>
  .editorial-body {
    min-height: 100vh;
    background: var(--page-bg);
    color: var(--text-strong);
  }

  .editorial-shell {
    min-height: 100vh;
  }

  .editorial-main {
    padding: 0;
  }

  .skip-link {
    position: absolute;
    left: 0.75rem;
    top: -4rem;
    z-index: 40;
    border-radius: 0.5rem;
    background: var(--accent);
    color: #fff;
    padding: 0.55rem 0.75rem;
    text-decoration: none;
  }

  .skip-link:focus-visible {
    top: 0.75rem;
  }
</style>
