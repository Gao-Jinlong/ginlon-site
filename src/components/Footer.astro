---
import { siteConfig } from '../data/site';
import { getLocaleFromUrl, getLocalizedPath } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);

const secondaryLinks = [
  { href: getLocalizedPath(locale, 'tags'), label: locale === 'zh' ? '标签归档' : 'Tag archive' },
  { href: getLocalizedPath(locale, 'techStack'), label: locale === 'zh' ? '技术栈' : 'Tech stack' },
  { href: getLocalizedPath(locale, 'blogs'), label: locale === 'zh' ? '全部文章' : 'All writing' },
];
---

<footer class="footer-shell">
  <div class="footer-card">
    <div class="footer-intro">
      <p class="footer-eyebrow">{locale === 'zh' ? 'PERSONAL BRAND SITE' : 'PERSONAL BRAND SITE'}</p>
      <h2>{locale === 'zh' ? '为长期主义保留一块安静的输出空间。' : 'A calm place for long-form thinking and shipping.'}</h2>
      <p>
        {locale === 'zh'
          ? '这里整理工程经验、文章写作与个人实践，也持续打磨更统一的网站体验。'
          : 'This space brings together engineering notes, writing, and the systems behind a more intentional personal site.'}
      </p>
    </div>

    <div class="footer-links">
      <div class="footer-link-group">
        <span>{locale === 'zh' ? 'Explore' : 'Explore'}</span>
        {
          secondaryLinks.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))
        }
      </div>

      <div class="footer-link-group">
        <span>{locale === 'zh' ? 'Contact' : 'Contact'}</span>
        {
          siteConfig.contactLinks.map((link) => (
            <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noreferrer' : undefined}>
              {link.label[locale]}
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <div class="footer-meta">
    <span>{siteConfig.recordNumber}</span>
    <span>{siteConfig.url.replace('https://', '')}</span>
  </div>
</footer>

<style>
  @reference "../styles/styles.css";

  .footer-shell {
    margin: 3rem auto 0;
    width: min(100% - 2rem, 76rem);
    padding-bottom: 2.5rem;
  }

  .footer-card {
    display: grid;
    gap: 2rem;
    border: 1px solid var(--surface-border);
    background: var(--surface-bg);
    padding: 1.5rem;
    box-shadow: var(--shadow-soft);
  }

  .footer-intro {
    max-width: 42rem;
  }

  .footer-eyebrow {
    margin: 0 0 0.8rem;
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .footer-intro h2 {
    margin: 0;
    color: var(--text-strong);
    font-size: clamp(1.4rem, 1rem + 1vw, 2rem);
    line-height: 1.18;
  }

  .footer-intro p {
    margin: 0.9rem 0 0;
    max-width: 36rem;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .footer-links {
    display: grid;
    gap: 1.5rem;
  }

  .footer-link-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    align-items: center;
  }

  .footer-link-group span {
    min-width: 4.5rem;
    color: var(--text-muted);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .footer-link-group a {
    color: var(--text-strong);
    text-decoration: none;
    transition: color 180ms ease;
  }

  .footer-link-group a:hover {
    color: var(--accent);
  }

  .footer-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1rem 0 0;
    color: var(--text-muted);
    font-size: 0.82rem;
  }

  @media (min-width: 860px) {
    .footer-card {
      grid-template-columns: minmax(0, 1.4fr) minmax(18rem, 1fr);
      align-items: start;
    }
  }

  @media (max-width: 640px) {
    .footer-shell {
      width: min(100% - 1rem, 76rem);
    }

    .footer-card {
      padding: 1.2rem;
    }

    .footer-link-group {
      align-items: flex-start;
      flex-direction: column;
    }

    .footer-link-group span {
      min-width: auto;
    }
  }
</style>
