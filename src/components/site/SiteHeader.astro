---
import ThemeToggleButton from './ThemeToggleButton.astro';

const navLinks = [
  { href: '/', label: '首页', matchPrefixes: ['/'] },
  { href: '/writing', label: '写作', matchPrefixes: ['/writing', '/blogs'] },
  { href: '/columns', label: '专栏', matchPrefixes: ['/columns'] },
];

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
/* 首页精确匹配，其余栏目按前缀匹配：博客文章页仍高亮「写作」 */
const isActive = (prefixes: string[]) =>
  prefixes.some((prefix) => {
    const normalized = prefix.replace(/\/+$/, '') || '/';
    if (normalized === '/') return pathname === '/';
    return pathname === normalized || pathname.startsWith(`${normalized}/`);
  });
---

<header class="site-header">
  <div class="site-header-bar shell">
    <a href="/" class="site-logo">Ginlon</a>

    <div class="site-header-right">
      <nav aria-label="主导航">
        <ul class="site-nav-list">
          {
            navLinks.map(item => (
              <li class:list={['site-nav-item']}>
                <a
                  href={item.href}
                  class:list={[
                    'site-nav-link',
                    isActive(item.matchPrefixes) && 'site-nav-link-active',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <ThemeToggleButton />
    </div>
  </div>
  <hr class="hairline site-header-divider" />
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--page-bg);
  }

  .site-header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 18px;
  }

  .site-logo {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 600;
    color: var(--text-strong);
    text-decoration: none;
  }

  .site-header-right {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .site-nav-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
  }

  .site-nav-item {
    display: inline-flex;
    align-items: center;
  }
  .site-nav-link {
    display: inline-flex;
    align-items: center;
    color: var(--text-muted);
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1;
    /* 负 margin 抵消 padding，保证 ≥24px 点击区且视觉位置不变 */
    padding: 6px 2px;
    margin: -6px -2px;
    transition: color 150ms ease;
  }

  @media (hover: hover) {
    .site-nav-link:hover {
      color: var(--accent);
    }
  }

  .site-nav-link-active {
    color: var(--accent);
  }

  .site-header-divider {
    margin: 0;
  }

  @media (max-width: 720px) {
    .site-header-bar {
      flex-wrap: wrap;
      padding-block: 20px;
    }

    .site-header-right {
      gap: 16px;
    }

    .site-nav-list {
      gap: 16px;
    }
  }
</style>
