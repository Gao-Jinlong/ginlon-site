---
import { siteConfig } from '../../data/site';
import { getLocaleFromUrl, getLocalizedPath } from '../../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <p class="site-footer-copy">
      {locale === 'zh' ? '持续记录工程、写作与长期实践。' : 'Documenting engineering, writing, and long-term craft.'}
    </p>

    <div class="site-footer-links">
      <a href={getLocalizedPath(locale, 'blogs')}>{locale === 'zh' ? '写作' : 'Writing'}</a>
      {
        siteConfig.contactLinks.map((link) => (
          <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noreferrer' : undefined}>
            {link.label[locale]}
          </a>
        ))
      }
    </div>

    <p class="site-footer-meta">
      <span>© {year} Ginlon</span>
      <span>{siteConfig.recordNumber}</span>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--surface-border);
    margin-top: 3rem;
    padding: 1.6rem 0 2rem;
  }

  .site-footer-inner {
    width: min(100% - 1.5rem, var(--shell-width));
    margin: 0 auto;
    display: grid;
    gap: 0.85rem;
  }

  .site-footer-copy {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .site-footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1rem;
    align-items: center;
  }

  .site-footer-links a {
    text-decoration: none;
    color: var(--text-strong);
    font-size: 0.88rem;
  }

  .site-footer-links a:hover {
    color: var(--accent);
  }

  .site-footer-meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
    color: var(--text-muted);
    font-size: 0.78rem;
  }

  @media (max-width: 640px) {
    .site-footer-inner {
      width: min(100% - 1rem, var(--shell-width));
    }
  }
</style>
