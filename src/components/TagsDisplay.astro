---
interface Props {
  tags?: string[];
  className?: string;
  maxTags?: number;
}

const { tags = [], className = '', maxTags } = Astro.props;

if (tags.length === 0) {
  // 如果没有标签，不渲染任何内容
  return null;
}

// 如果设置了 maxTags，只显示前 N 个
const displayTags = maxTags ? tags.slice(0, maxTags) : tags;

// 如果有更多标签
const hasMoreTags = maxTags && tags.length > maxTags;
---

<div class={`tags ${className}`}>
  {displayTags.map((tag, index) => (
    <a
      href={`/tags/${encodeURIComponent(tag)}`}
      class={`tag gradient-${index}`}
      aria-label={`查看标签: ${tag}`}
    >
      <span class="tag-text">{tag}</span>
    </a>
  ))}
  {hasMoreTags && (
    <span class="tag-more">+{tags.length - maxTags}</span>
  )}
</div>

<style>
  .tags {
    @apply flex flex-wrap gap-2;
  }

  .tag {
    @apply inline-flex items-center;
    @apply px-3 py-1.5 text-sm font-medium;
    @apply rounded-lg;
    @apply text-white;
    @apply hover:scale-105;
    @apply transition-all duration-200;
    @apply cursor-pointer;
  }

  /* 渐变色标签 */
  .tag.gradient-0 {
    @apply bg-gradient-to-r from-blue-500 to-purple-500 hover:from-blue-600 hover:to-purple-600;
  }

  .tag.gradient-1 {
    @apply bg-gradient-to-r from-pink-500 to-red-500 hover:from-pink-600 hover:to-red-600;
  }

  .tag.gradient-2 {
    @apply bg-gradient-to-r from-cyan-500 to-blue-500 hover:from-cyan-600 hover:to-blue-600;
  }

  .tag.gradient-3 {
    @apply bg-gradient-to-r from-green-500 to-emerald-500 hover:from-green-600 hover:to-emerald-600;
  }

  .tag.gradient-4 {
    @apply bg-gradient-to-r from-orange-500 to-amber-500 hover:from-orange-600 hover:to-amber-600;
  }

  .tag-text {
    @apply font-medium;
  }

  /* 更多标签指示器 */
  .tag-more {
    @apply px-3 py-1.5 text-sm font-medium;
    @apply text-gray-500 dark:text-gray-400;
    @apply bg-gray-100 dark:bg-gray-800;
    @apply rounded-lg;
  }

  /* 紧凑模式 */
  .tags.compact .tag {
    @apply px-2 py-1 text-xs;
  }

  .tags.compact .tag-more {
    @apply px-2 py-1 text-xs;
  }
</style>
