---
import { dayjs, format } from '../utils/dayjs';
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';

interface BlogData {
  data: {
    subtitle?: string;
    permalink: string;
    title: string;
    createdAt: string;
  };
}

const { blogs } = Astro.props as {
  blogs: BlogData[];
};
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<aside class="recent-posts">
  <div class="recent-posts-header">
    <p class="recent-posts-eyebrow">MORE WRITING</p>
    <h2 class="recent-posts-title">{t('blogs.recentPosts')}</h2>
  </div>

  <div class="recent-posts-grid">
    {
      blogs.slice(0, 4).map(({ data: { permalink, title, createdAt, subtitle } }) => (
        <a href={getLocalizedPath(locale, `blogs/${permalink}`)} class="recent-post-card">
          <span class="recent-post-date">{dayjs(createdAt, locale).format(format)}</span>
          <h3 class="recent-post-link-title">{title}</h3>
          <p class="recent-post-description">
            {subtitle || (locale === 'zh' ? '继续阅读这篇文章。' : 'Continue reading this article.')}
          </p>
        </a>
      ))
    }
  </div>
</aside>

<style>
  .recent-posts {
    display: grid;
    gap: 1.25rem;
  }

  .recent-posts-header {
    display: grid;
    gap: 0.45rem;
    max-width: 34rem;
  }

  .recent-posts-eyebrow {
    margin: 0;
    color: var(--accent);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .recent-posts-title {
    margin: 0;
    color: var(--text-strong);
    font-size: clamp(1.35rem, 1.1rem + 0.9vw, 1.9rem);
    line-height: 1.15;
  }

  .recent-posts-grid {
    display: grid;
    gap: 1rem;
  }

  .recent-post-card {
    display: grid;
    gap: 0.7rem;
    border: 1px solid var(--surface-border);
    background: var(--surface-bg-strong);
    padding: 1rem;
    text-decoration: none;
    box-shadow: var(--shadow-soft);
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .recent-post-card:hover {
    transform: translateY(-2px);
    border-color: rgba(31, 118, 103, 0.26);
    box-shadow: 0 20px 36px rgba(15, 23, 42, 0.08);
  }

  .recent-post-date {
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  .recent-post-link-title {
    margin: 0;
    color: var(--text-strong);
    font-size: 1.02rem;
    line-height: 1.4;
  }

  .recent-post-description {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  @media (min-width: 768px) {
    .recent-posts-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
