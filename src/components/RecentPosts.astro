---
import { t } from 'astro-i18n';
import type { getCollection } from 'astro:content';
import dayjs from 'dayjs';

interface BlogData {
  data: {
    permalink: string;
    title: string;
    createdAt: string;
  };
}

const { blogs } = Astro.props as {
  blogs: BlogData[];
};
const routeName = t('blogs.titre');
---

<aside class="recent-posts">
  <div class="recent-posts-container">
    <h3 class="recent-posts-title">
      {t('blogs.recentPosts')}
    </h3>
    <ul class="recent-posts-list">
      {
        blogs.slice(0, 5).map(({ data: { permalink, title, createdAt } }) => (
          <li class="recent-post-item">
            <a
              href={`${import.meta.env.BASE_URL}${routeName}/${permalink}`}
              class="recent-post-link"
            >
              <span class="recent-post-title">{title}</span>
              {createdAt && (
                <span class="recent-post-date">
                  {dayjs(createdAt).format('YYYY-MM-DD')}
                </span>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</aside>

<style>
  .recent-posts {
    @apply mt-16 w-full;
  }

  .recent-posts-container {
    @apply overflow-hidden rounded-lg border border-gray-100 bg-white/90 p-4 shadow-sm backdrop-blur-sm transition-all duration-200 hover:border-gray-200 hover:shadow-md dark:border-gray-800 dark:bg-gray-900/90 dark:hover:border-gray-700;
  }

  .recent-posts-title {
    @apply mb-3 text-base font-medium text-gray-900 dark:text-gray-100;
  }

  .recent-posts-list {
    @apply space-y-1.5;
  }

  .recent-post-item {
    @apply text-sm transition-colors;
  }

  .recent-post-link {
    @apply block rounded px-2 py-2 text-gray-600 transition-colors hover:bg-gray-100 hover:text-blue-600 dark:text-gray-400 dark:hover:bg-gray-800/60 dark:hover:text-blue-400;
  }

  .recent-post-title {
    @apply block font-medium;
  }

  .recent-post-date {
    @apply mt-1 block text-xs text-gray-500 dark:text-gray-500;
  }
</style>
