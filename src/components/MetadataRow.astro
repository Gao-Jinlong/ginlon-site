---
type Props = {
  date: string;
  tags?: string[] | undefined;
};

const { date, tags = [] } = Astro.props as Props;
---

<div class="metadata-row">
  <time>{date}</time>
  {
    tags.length > 0 && (
      <>
        <span aria-hidden="true">/</span>
        {tags.map((tag) => <span class="metadata-tag">{tag}</span>)}
      </>
    )
  }
</div>

<style>
  .metadata-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .metadata-tag {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    border: 1px solid var(--surface-border);
    padding: 0.2rem 0.55rem;
    font-size: 0.78rem;
    color: var(--text-strong);
  }
</style>
