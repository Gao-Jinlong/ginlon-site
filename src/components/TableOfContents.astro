---
import { getLocaleFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  headings: {
    depth: number;
    slug: string;
    text: string;
  }[];
}

const { headings } = Astro.props as Props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const filteredHeadings = headings.filter((heading) => heading.depth <= 4);
---

<nav class="toc">
  <div class="toc-container">
    <p class="toc-eyebrow">ON THIS PAGE</p>
    <h2 class="toc-title">{t('blogs.tableOfContents')}</h2>
    <ul class="toc-list">
      {
        filteredHeadings.map((heading) => (
          <li class:list={['toc-item', `depth-${heading.depth}`]}>
            <a href={`#${heading.slug}`} class="toc-link">
              {heading.text}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<style>
  .toc {
    position: sticky;
    top: 6.5rem;
  }

  .toc-container {
    display: grid;
    gap: 0.8rem;
    overflow-y: auto;
    border: 1px solid var(--surface-border);
    background: var(--surface-bg);
    padding: 1rem;
    box-shadow: var(--shadow-soft);
    max-height: calc(100vh - 8rem);
  }

  .toc-eyebrow {
    margin: 0;
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .toc-title {
    margin: 0;
    color: var(--text-strong);
    font-size: 1rem;
    line-height: 1.2;
  }

  .toc-list {
    display: grid;
    gap: 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc-item {
    font-size: 0.92rem;
  }

  .toc-link {
    display: block;
    overflow: hidden;
    padding: 0.35rem 0.55rem;
    color: var(--text-muted);
    border-radius: 0.75rem;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: background-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .toc-link:hover {
    background: var(--accent-soft);
    color: var(--text-strong);
    transform: translateX(2px);
  }

  .depth-1 {
    font-weight: 600;
  }

  .depth-2 {
    padding-left: 0.5rem;
  }

  .depth-3 {
    padding-left: 1rem;
    font-size: 0.84rem;
  }

  .depth-4 {
    padding-left: 1.5rem;
    font-size: 0.82rem;
  }

  @media (max-width: 1023px) {
    .toc {
      position: static;
    }
  }
</style>
