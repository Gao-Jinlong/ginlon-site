---
const { title, description, technologies, href, imgSrc, imgAlt } = Astro.props;
import { Image } from 'astro:assets';
import Button from '../components/BtnProject.astro';
import Technologies from '../components/Technologies.astro';
---

<div class="project-card">
  <div class="project-card-inner">
    <div class="project-image-container">
      <Image
        src={imgSrc}
        alt={imgAlt}
        class="project-image"
        width={300}
        height={250}
      />
    </div>
    <div class="project-content">
      <h3 class="project-title">
        {title}
      </h3>
      <p class="project-description">
        {description}
      </p>
      <Technologies technologies={technologies} />
      <Button text="Website" href={href} />
    </div>
  </div>
</div>

<style>
  .project-card {
    @apply mb-8 w-full transition-all duration-200;
  }

  .project-card-inner {
    @apply overflow-hidden rounded-lg border border-gray-100 bg-white/90 shadow-sm backdrop-blur-sm transition-all duration-200 hover:border-gray-200 hover:shadow-md dark:border-gray-800 dark:bg-gray-900/90 dark:hover:border-gray-700;
  }

  .project-image-container {
    @apply w-full;
  }

  .project-image {
    @apply h-[250px] w-full object-cover grayscale transition-all duration-300 hover:filter-none;
  }

  .project-content {
    @apply p-6;
  }

  .project-title {
    @apply mb-3 text-lg font-medium text-gray-900 dark:text-gray-100;
  }

  .project-description {
    @apply mb-4 text-sm text-gray-600 dark:text-gray-400;
  }
</style>
