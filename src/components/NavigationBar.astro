---
import ThemeToggler from '../components/ThemeToggler.astro';
import { t } from 'astro-i18n';

const links = [
  { href: '', label: t('navigation.home') },
  { href: 'blogs', label: t('navigation.blogs') },
  { href: 'tags', label: t('navigation.tags') },
  { href: 'about', label: t('navigation.about') },
];

const { pathname } = Astro.url;
const isActive = (href: string) => {
  const url = `${import.meta.env.BASE_URL}${href}`.replace(/\/*$/, '');
  return url === pathname || url === pathname.replace(/\/*$/, '');
};
---

<nav class="nav-container">
  <div class="nav-content">
    <ul class="nav-links">
      {
        links.map(({ href, label }) => (
          <li class="nav-item">
            <a
              href={`${import.meta.env.BASE_URL}${href}`}
              class:list={['nav-link', isActive(href) && 'nav-link-active']}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
    <ThemeToggler />
  </div>
  <div class="nav-backdrop"></div>
</nav>

<style>
  .nav-container {
    @apply sticky top-0 z-50;
  }

  .nav-content {
    @apply relative z-10 mx-auto flex items-center justify-between bg-white/80 px-4 py-4 dark:bg-gray-900/80;
    @apply max-w-4xl lg:max-w-5xl xl:max-w-6xl;
  }

  .nav-backdrop {
    @apply absolute inset-0 backdrop-blur-sm transition-all duration-200;
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.05);
  }

  .nav-links {
    @apply flex flex-wrap gap-2;
  }

  .nav-item {
    @apply list-none;
  }

  .nav-link {
    @apply rounded-lg border border-transparent px-3 py-1.5 text-sm text-gray-600 transition-all duration-200 hover:border-gray-200 hover:bg-white/90 hover:text-blue-600 hover:shadow-sm dark:text-gray-400 dark:hover:border-gray-700 dark:hover:bg-gray-800/60 dark:hover:text-blue-400;
  }

  .nav-link-active {
    @apply border-gray-200 bg-white/90 text-blue-600 shadow-sm dark:border-gray-700 dark:bg-gray-800/60 dark:text-blue-400;
  }
</style>

