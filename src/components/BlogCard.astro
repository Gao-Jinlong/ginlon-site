---
import { dayjs } from '../utils/dayjs'
import TagsDisplay from './TagsDisplay.astro'

interface Props {
  blog: {
    data: {
      draft?: boolean
      title: string
      permalink: string
      createdAt: string
      description?: string
      tags?: string[]
      poster?: string
      subtitle?: string
    }
  }
}

const { blog } = Astro.props

// 判断是否为外部URL
const isExternalUrl = (url: string) => url.startsWith('http://') || url.startsWith('https://')

// 获取第一个字符作为图标
const getFirstChar = (title: string) => title.charAt(0).toUpperCase()

// 生成基于标题的随机颜色
const getColorFromTitle = (title: string): { bg: string; text: string } => {
  const colors = [
    { bg: 'bg-blue-50 dark:bg-blue-900/30', text: 'text-blue-600 dark:text-blue-400' },
    { bg: 'bg-purple-50 dark:bg-purple-900/30', text: 'text-purple-600 dark:text-purple-400' },
    { bg: 'bg-green-50 dark:bg-green-900/30', text: 'text-green-600 dark:text-green-400' },
    { bg: 'bg-yellow-50 dark:bg-yellow-900/30', text: 'text-yellow-600 dark:text-yellow-400' },
    { bg: 'bg-pink-50 dark:bg-pink-900/30', text: 'text-pink-600 dark:text-pink-400' },
    { bg: 'bg-indigo-50 dark:bg-indigo-900/30', text: 'text-indigo-600 dark:text-indigo-400' },
    { bg: 'bg-teal-50 dark:bg-teal-900/30', text: 'text-teal-600 dark:text-teal-400' },
    { bg: 'bg-orange-50 dark:bg-orange-900/30', text: 'text-orange-600 dark:text-orange-400' },
  ]

  // 根据标题长度选择颜色
  const index = title.length % colors.length
  return colors[index] as { bg: string; text: string }
}

const { bg: bgColor, text: textColor } = getColorFromTitle(blog.data.title)
---

<a href={`/blogs/${blog.data.permalink}`} class="blog-card">
  <div class="blog-card-inner">
    {
      blog.data.poster && isExternalUrl(blog.data.poster) ? (
        // 外部URL - 使用img标签
        <div class="blog-image">
          <img
            src={blog.data.poster}
            alt={blog.data.title}
            class="poster-image"
            loading="lazy"
            onerror="this.parentElement.parentElement.classList.add('image-error')"
          />
          <div class="image-fallback">
            <span class={`fallback-text ${textColor}`}>
              {getFirstChar(blog.data.title)}
            </span>
          </div>
        </div>
      ) : blog.data.poster ? (
        // 本地路径 - 使用占位图（因为博客目录下没有poster图片）
        <div class={`blog-image ${bgColor}`}>
          <span class={`placeholder-icon ${textColor}`}>
            {getFirstChar(blog.data.title)}
          </span>
        </div>
      ) : (
        // 无封面 - 使用占位图
        <div class={`blog-image ${bgColor}`}>
          <span class={`placeholder-icon ${textColor}`}>
            {getFirstChar(blog.data.title)}
          </span>
        </div>
      )
    }
    <div class="blog-content">
      <h3 class="blog-title">
        {blog.data.draft ? '🚧' : ''}
        {blog.data.title}
      </h3>
      <time class="blog-date">
        {dayjs(blog.data.createdAt).format('YYYY-MM-DD')}
      </time>
      {blog.data.tags && (
        <div class="blog-tags">
          <TagsDisplay tags={blog.data.tags} />
        </div>
      )}
    </div>
  </div>
</a>

<style>
  .blog-card {
    @apply block;
    @apply transition-all duration-300;
    @apply hover:scale-[1.01];
  }

  .blog-card-inner {
    @apply flex flex-col md:flex-row;
    @apply overflow-hidden rounded-lg;
    @apply bg-white dark:bg-gray-900;
    @apply border border-gray-200 dark:border-gray-700;
    @apply shadow-sm;
    @apply transition-all duration-300;
    @apply hover:shadow-lg;
    @apply hover:border-gray-300 dark:hover:border-gray-600;
  }

  /* 图片区域 - 左侧 */
  .blog-image {
    @apply relative h-48 w-full md:h-auto md:w-48 md:flex-shrink-0;
    @apply overflow-hidden;
    @apply flex items-center justify-center;
    /* 确保在移动端有最小高度，桌面端使用 aspect-ratio 保持比例 */
    @apply min-h-[192px];
  }

  @media (min-width: 768px) {
    .blog-image {
      /* 在桌面端使用 aspect-ratio 确保容器有高度 */
      aspect-ratio: 1 / 1;
      min-height: auto;
    }
  }

  .poster-image {
    @apply h-full w-full object-cover;
    @apply transition-transform duration-300;
    @apply absolute inset-0;
    /* 确保图片至少有一个最小高度，防止加载前塌陷 */
    @apply min-h-[192px];
  }

  .blog-card:hover .poster-image {
    @apply scale-110;
  }

  /* 图片加载失败时的fallback */
  .image-fallback {
    @apply absolute inset-0;
    @apply flex items-center justify-center;
    @apply hidden;
    @apply w-full h-full;
  }

  .blog-image.image-error .poster-image {
    @apply hidden;
  }

  .blog-image.image-error .image-fallback {
    @apply flex;
  }

  .fallback-text {
    @apply text-6xl font-bold;
  }

  .placeholder-icon {
    @apply text-6xl font-bold;
  }

  /* 内容区域 - 右侧 */
  .blog-content {
    @apply flex flex-col justify-between;
    @apply p-6 md:p-8;
    @apply flex-1;
  }

  .blog-title {
    @apply text-xl font-bold;
    @apply text-gray-900 dark:text-gray-100;
    @apply mb-3;
    @apply line-clamp-2;
    @apply leading-snug;
  }

  .blog-date {
    @apply text-sm text-gray-500 dark:text-gray-400;
    @apply mb-3;
  }

  .blog-tags {
    @apply mt-auto;
  }

  /* 移动端适配 */
  @media (max-width: 767px) {
    .blog-card-inner {
      @apply flex-col;
    }

    .blog-image {
      @apply w-full h-48;
    }

    .blog-content {
      @apply p-6;
    }

    .blog-title {
      @apply text-lg;
    }
  }
</style>
