---
import { dayjs } from '../utils/dayjs';
import MetadataRow from './MetadataRow.astro';
import { getLocaleFromUrl, getLocalizedPath } from '../i18n/utils';

interface Props {
  blog: {
    data: {
      draft?: boolean | undefined;
      title: string;
      permalink: string;
      createdAt: string;
      tags?: string[] | undefined;
      poster?: string | undefined;
      subtitle?: string | undefined;
      category?: string | undefined;
    };
  };
}

const { blog } = Astro.props as Props;
const locale = getLocaleFromUrl(Astro.url);
const previewText = blog.data.subtitle ?? (locale === 'zh' ? '继续阅读这篇文章' : 'Continue reading this article');
const categoryLabel =
  blog.data.category === 'note'
    ? locale === 'zh'
      ? 'Notes'
      : 'Notes'
    : locale === 'zh'
      ? 'Engineering'
      : 'Engineering';
---

<a href={getLocalizedPath(locale, `blogs/${blog.data.permalink}`)} class="blog-card">
  <div class="blog-visual">
    {blog.data.poster ? (
      <img src={blog.data.poster} alt={blog.data.title} class="blog-poster" loading="lazy" />
    ) : (
      <div class="blog-placeholder">
        <span>{categoryLabel}</span>
        <strong>{dayjs(blog.data.createdAt, locale).format('YYYY')}</strong>
      </div>
    )}
  </div>

  <div class="blog-copy">
    <p class="blog-category">{categoryLabel}</p>
    <h3 class="blog-title">
      {blog.data.draft ? 'Draft · ' : ''}
      {blog.data.title}
    </h3>
    <p class="blog-preview">{previewText}</p>
    <MetadataRow date={dayjs(blog.data.createdAt, locale).format('YYYY-MM-DD')} tags={blog.data.tags} />
  </div>
</a>

<style>
  .blog-card {
    display: grid;
    gap: 1rem;
    border: 1px solid var(--surface-border);
    background: var(--surface-bg-strong);
    padding: 1rem;
    text-decoration: none;
    box-shadow: var(--shadow-soft);
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .blog-card:hover {
    transform: translateY(-2px);
    border-color: rgba(31, 118, 103, 0.26);
    box-shadow: 0 20px 36px rgba(15, 23, 42, 0.08);
  }

  .blog-visual {
    min-height: 12rem;
    overflow: hidden;
    border: 1px solid var(--surface-border);
    background: linear-gradient(135deg, rgba(31, 118, 103, 0.1), rgba(114, 140, 168, 0.06));
  }

  .blog-poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .blog-placeholder {
    display: flex;
    height: 100%;
    min-height: 12rem;
    flex-direction: column;
    justify-content: space-between;
    padding: 1rem;
  }

  .blog-placeholder span {
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .blog-placeholder strong {
    color: var(--text-strong);
    font-size: clamp(2.4rem, 1.6rem + 1vw, 3.6rem);
    line-height: 1;
  }

  .blog-copy {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .blog-category {
    margin: 0;
    color: var(--accent);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .blog-title {
    margin: 0;
    color: var(--text-strong);
    font-size: 1.25rem;
    line-height: 1.25;
  }

  .blog-preview {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.75;
  }

  @media (min-width: 900px) {
    .blog-card {
      grid-template-columns: minmax(16rem, 20rem) minmax(0, 1fr);
      align-items: stretch;
      padding: 1.1rem;
    }
  }
</style>
