---
import { Image } from 'astro:assets'
import { dayjs } from '../utils/dayjs'
import TagsDisplay from './TagsDisplay.astro'

interface Props {
  blog: {
    data: {
      draft?: boolean
      title: string
      permalink: string
      createdAt: string
      description?: string
      tags?: string[]
      poster?: string
      subtitle?: string
    }
  }
}

const { blog } = Astro.props

const getRandomColor = () => {
  const colors = [
    'bg-blue-50 dark:bg-blue-900/30',
    'bg-purple-50 dark:bg-purple-900/30',
    'bg-green-50 dark:bg-green-900/30',
    'bg-yellow-50 dark:bg-yellow-900/30',
    'bg-pink-50 dark:bg-pink-900/30',
  ]
  return colors[Math.floor(Math.random() * colors.length)]
}

const getRandomPattern = () => {
  const patterns = [
    'pattern-dots',
    'pattern-lines',
    'pattern-grid',
    'pattern-waves',
  ]
  return patterns[Math.floor(Math.random() * patterns.length)]
}
---

<a href={`/blogs/${blog.data.permalink}`} class="blog-card">
  <div class="blog-card-inner">
    {
      blog.data.poster ? (
        <div class="blog-image">
          <Image
            src={blog.data.poster}
            alt={blog.data.title}
            width={400}
            height={200}
            class="poster-image"
          />
        </div>
      ) : (
        <div class={`blog-image ${getRandomColor()} ${getRandomPattern()}`}>
          <span class="placeholder-icon">📄</span>
        </div>
      )
    }
    <div class="blog-content">
      <h3 class="blog-title">
        {blog.data.draft ? '🚧' : ''}
        {blog.data.title}
      </h3>
      <time class="blog-date">
        {dayjs(blog.data.createdAt).format('YYYY-MM-DD')}
      </time>
      {blog.data.tags && (
        <div class="blog-tags">
          <TagsDisplay tags={blog.data.tags} />
        </div>
      )}
    </div>
  </div>
</a>

<style>
  .blog-card {
    @apply block;
    @apply transition-all duration-300;
    @apply hover:scale-[1.01];
  }

  .blog-card-inner {
    @apply flex flex-col md:flex-row;
    @apply overflow-hidden rounded-lg;
    @apply bg-white dark:bg-gray-900;
    @apply border border-gray-200 dark:border-gray-700;
    @apply shadow-sm;
    @apply transition-all duration-300;
    @apply hover:shadow-lg;
    @apply hover:border-gray-300 dark:hover:border-gray-600;
  }

  /* 图片区域 - 左侧 */
  .blog-image {
    @apply relative h-48 w-full md:h-auto md:w-48 md:flex-shrink-0;
    @apply overflow-hidden;
    @apply flex items-center justify-center;
  }

  .poster-image {
    @apply h-full w-full object-cover;
    @apply transition-transform duration-300;
  }

  .blog-card:hover .poster-image {
    @apply scale-110;
  }

  .placeholder-icon {
    @apply text-6xl text-gray-300 dark:text-gray-600;
  }

  /* 内容区域 - 右侧 */
  .blog-content {
    @apply flex flex-col justify-between;
    @apply p-6 md:p-8;
    @apply flex-1;
  }

  .blog-title {
    @apply text-xl font-bold;
    @apply text-gray-900 dark:text-gray-100;
    @apply mb-3;
    @apply line-clamp-2;
    @apply leading-snug;
  }

  .blog-date {
    @apply text-sm text-gray-500 dark:text-gray-400;
    @apply mb-3;
  }

  .blog-tags {
    @apply mt-auto;
  }

  /* 移动端适配 */
  @media (max-width: 767px) {
    .blog-card-inner {
      @apply flex-col;
    }

    .blog-image {
      @apply w-full h-48;
    }

    .blog-content {
      @apply p-6;
    }

    .blog-title {
      @apply text-lg;
    }
  }
</style>
