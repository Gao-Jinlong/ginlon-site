---
interface Tab {
  id: string
  title: string
  icon: string
}

interface Props {
  tabs: Tab[]
  defaultTab?: string
  urlParam?: string
}

const { tabs, defaultTab = tabs?.[0]?.id, urlParam = 'tab' } = Astro.props
---

<div class="tabs">
  {
    tabs.map(tab => (
      <button
        class="tab-button"
        data-category={tab.id}
        data-default={tab.id === defaultTab}
      >
        <span class="tab-icon">{tab.icon}</span>
        <span class="tab-title">{tab.title}</span>
      </button>
    ))
  }
</div>

<style>
  .tabs {
    @apply mb-8 flex gap-4;
    @apply border-b border-gray-200 dark:border-gray-700;
  }

  .tab-button {
    @apply flex items-center gap-2 px-4 py-2;
    @apply text-gray-600 dark:text-gray-400;
    @apply border-b-2 border-transparent;
    @apply transition-all duration-200;
    @apply hover:text-gray-900 dark:hover:text-gray-100;
  }

  .tab-button[data-active='true'] {
    @apply text-blue-600 dark:text-blue-400;
    @apply border-blue-600 dark:border-blue-400;
  }

  .tab-icon {
    @apply text-xl;
  }

  .tab-title {
    @apply font-medium;
  }
</style>

<script define:vars={{ urlParam }} is:inline>
  // Tab 切换功能
  document.addEventListener('astro:page-load', () => {
    // 变量声明
    const urlParamName = urlParam
    const tabButtons = document.querySelectorAll('.tab-button')
    const tabPanels = document.querySelectorAll('.tab-panel')

    // 从 URL 中读取初始状态
    function getActiveTabFromUrl() {
      const urlParams = new URLSearchParams(window.location.search)
      return urlParams.get(urlParamName)
    }

    // 更新 URL 参数
    function updateUrlParam(tabId) {
      const url = new URL(window.location)
      url.searchParams.set(urlParamName, tabId)
      window.history.replaceState({}, '', url)
    }

    // 初始化状态
    function initializeTabs() {
      const activeTabFromUrl = getActiveTabFromUrl()
      let activeTab = activeTabFromUrl

      // 如果 URL 中没有指定 tab 或指定的 tab 不存在，使用默认 tab
      if (
        !activeTab ||
        !Array.from(tabButtons).some(
          btn => btn.getAttribute('data-category') === activeTab
        )
      ) {
        const defaultButton = document.querySelector(
          '.tab-button[data-default="true"]'
        )
        activeTab =
          defaultButton?.getAttribute('data-category') ||
          tabButtons[0]?.getAttribute('data-category')
      }

      // 更新按钮状态
      tabButtons.forEach(btn => {
        const isActive = btn.getAttribute('data-category') === activeTab
        btn.setAttribute('data-active', isActive ? 'true' : 'false')
      })

      // 更新面板状态
      tabPanels.forEach(panel => {
        const isActive = panel.getAttribute('data-category') === activeTab
        panel.setAttribute('data-active', isActive ? 'true' : 'false')
      })

      // 如果当前激活的 tab 不是从 URL 来的，更新 URL
      if (activeTab && activeTab !== activeTabFromUrl) {
        updateUrlParam(activeTab)
      }
    }

    // 立即初始化
    initializeTabs()

    tabButtons.forEach(button => {
      button.addEventListener('click', () => {
        const category = button.getAttribute('data-category')

        // 更新按钮状态
        tabButtons.forEach(btn => btn.setAttribute('data-active', 'false'))
        button.setAttribute('data-active', 'true')

        // 更新面板状态
        tabPanels.forEach(panel => {
          panel.setAttribute(
            'data-active',
            panel.getAttribute('data-category') === category ? 'true' : 'false'
          )
        })

        // 更新 URL 参数
        updateUrlParam(category)
      })
    })

    // 监听浏览器前进/后退按钮
    window.addEventListener('popstate', () => {
      initializeTabs()
    })
  })
</script>

