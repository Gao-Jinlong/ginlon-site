---
export type Props = {
  to: string;
  title: string;
  gradientFrom?: string;
  gradientTo?: string;
};

const { to, title } = Astro.props;
---

<a href={`${import.meta.env.BASE_URL}${to}`} class="card">
  <div class="card-inner">
    <div class="card-title">
      {title}
    </div>
  </div>
</a>

<style>
  @reference "../styles/styles.css";

  .card {
    @apply block w-full transition-all duration-200;
  }

  .card-inner {
    @apply rounded-lg border border-gray-100 bg-white/90 p-4 shadow-sm backdrop-blur-sm transition-all duration-200 hover:border-gray-200 hover:bg-gray-50 hover:shadow-md dark:border-gray-800 dark:bg-gray-900/90 dark:hover:border-gray-700 dark:hover:bg-gray-800/60;
  }

  .card-title {
    @apply text-base font-medium text-gray-900 dark:text-gray-100;
  }
</style>
