---
export type Props = {
  to: string;
  title: string;
  gradientFrom: string;
  gradientTo: string;
};

const { to, title } = Astro.props;
---

<a
  href={`${import.meta.env.BASE_URL}${to}`}
  class={`card rounded-md transition-transform duration-200 ease-in-out bg-gray-100 `}
>
  <div class="card-inner bg-red flex flex-col rounded-md p-6 dark:bg-[#18181b]">
    <div class="card-title text-lg font-medium leading-7 dark:text-gray-100">
      {title}
    </div>
    <!-- <div class="flex items-center justify-between mt-4">
      <div class="card-footer text-gray-900 dark:text-gray-100 text-sm">
        &rarr;
      </div>
    </div> -->
  </div>
</a>

<style>
  @keyframes rotate {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }
</style>
