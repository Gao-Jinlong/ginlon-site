---
type FocusAreaItem = {
  title: string;
  description: string;
  meta: string;
};

type Props = {
  eyebrow: string;
  title: string;
  description: string;
  items: FocusAreaItem[];
};

const { description, eyebrow, items, title } = Astro.props as Props;
---

<section class="focus-shell animate">
  <div class="focus-header">
    <p class="focus-eyebrow">{eyebrow}</p>
    <h2 class="focus-title">{title}</h2>
    <p class="focus-description">{description}</p>
  </div>

  <div class="focus-grid">
    {
      items.map((item) => (
        <article class="focus-card">
          <p class="focus-meta">{item.meta}</p>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </article>
      ))
    }
  </div>
</section>

<style>
  .focus-shell {
    display: grid;
    gap: 1.25rem;
  }

  .focus-header {
    max-width: 38rem;
  }

  .focus-eyebrow {
    margin: 0 0 0.8rem;
    color: var(--accent);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .focus-title {
    margin: 0;
    color: var(--text-strong);
    font-size: clamp(1.7rem, 1.25rem + 1.2vw, 2.7rem);
    line-height: 1.08;
  }

  .focus-description {
    margin: 0.9rem 0 0;
    color: var(--text-muted);
    line-height: 1.75;
  }

  .focus-grid {
    display: grid;
    gap: 1rem;
  }

  .focus-card {
    border: 1px solid var(--surface-border);
    background: var(--surface-bg);
    padding: 1.25rem;
    box-shadow: var(--shadow-soft);
  }

  .focus-meta {
    margin: 0 0 0.7rem;
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .focus-card h3 {
    margin: 0;
    color: var(--text-strong);
    font-size: 1.2rem;
  }

  .focus-card p:last-child {
    margin: 0.8rem 0 0;
    color: var(--text-muted);
    line-height: 1.75;
  }

  @media (min-width: 768px) {
    .focus-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
