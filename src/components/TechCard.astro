---
const { url, alt } = Astro.props;

import { Image } from 'astro:assets';
---

<div class="tech-card">
  <div class="tech-card-inner">
    <Image
      src={url}
      alt={alt}
      class="tech-image"
      width={80}
      height={80}
      loading="eager"
    />
  </div>
</div>

<style>
  .tech-card {
    @apply relative transition-all duration-200;
    opacity: 0;
    transform: translateY(20px);
  }

  .tech-card-inner {
    @apply rounded-lg border border-gray-100 bg-white/90 p-4 shadow-sm backdrop-blur-sm transition-all duration-200 hover:-translate-y-1 hover:border-gray-200 hover:shadow-md dark:border-gray-800 dark:bg-gray-900/90 dark:hover:border-gray-700;
    -webkit-user-select: none;
    user-select: none;
  }

  .tech-image {
    @apply h-16 w-16 object-contain;
  }
</style>
