---
import RedirectPage from '../../../../components/site/RedirectPage.astro';
import { siteConfig } from '../../../../data/site';
import { getAllTags } from '../../../../utils/getTags';

export async function getStaticPaths() {
  const tags = await getAllTags('zh');

  return tags.map((tag) => ({
    params: { tag: tag.slug },
  }));
}

const { tag } = Astro.params;
---

<RedirectPage
  target={`/writing?tag=${encodeURIComponent(tag ?? '')}`}
  canonical={new URL(`/en/tags/${tag}`, siteConfig.url).toString()}
/>
