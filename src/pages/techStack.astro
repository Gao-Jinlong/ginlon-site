---
import PageContainer from '../components/PageContainer.astro';
import PageIntro from '../components/PageIntro.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { getLocaleFromUrl } from '../i18n/utils';
import Main from '../layouts/Main.astro';
import { techCardsData } from '../data/data';
import enCommon from '../i18n/common/en.json';
import zhCommon from '../i18n/common/zh.json';

const locale = getLocaleFromUrl(Astro.url);
const dictionary = locale === 'zh' ? zhCommon : enCommon;
const techStack = dictionary.techStack;
const pageMeta =
  locale === 'zh'
    ? {
        title: '技术栈',
        description: '查看 Ginlon 常用的前端技术组合与工程工具。',
      }
    : {
        title: 'Tech Stack',
        description: "See the tools Ginlon uses most often across frontend and content work.",
      };
---

<Main pageMeta={pageMeta}>
  <PageContainer class="tech-page">
    <PageIntro
      eyebrow={techStack.eyebrow}
      title={techStack.title}
      description={techStack.description}
    />

    <section class="tech-summary-card">
      <SectionHeader
        title={techStack.summaryTitle}
        description={techStack.summaryDescription}
      />
    </section>

    <section class="tech-grid">
      {techCardsData.map((techCard) => (
        <article class="tech-card">
          <div class="tech-logo-wrap">
            <img src={techCard.url} alt={techCard.alt} class="tech-logo" loading="lazy" />
          </div>
          <h2>{techCard.alt}</h2>
        </article>
      ))}
    </section>
  </PageContainer>
</Main>

<style>
  .tech-page {
    display: grid;
    gap: 2rem;
    padding-top: 2rem;
    padding-bottom: 3rem;
  }

  .tech-summary-card {
    border: 1px solid var(--surface-border);
    background: var(--surface-bg-strong);
    padding: 1.2rem;
    box-shadow: var(--shadow-soft);
  }

  .tech-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .tech-card {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
    border: 1px solid var(--surface-border);
    background: var(--surface-bg-strong);
    padding: 1rem;
    box-shadow: var(--shadow-soft);
    transition: transform 180ms ease, border-color 180ms ease;
  }

  .tech-card:hover {
    transform: translateY(-2px);
    border-color: rgba(31, 118, 103, 0.26);
  }

  .tech-logo-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    border: 1px solid var(--surface-border);
    background: rgba(255, 255, 255, 0.45);
  }

  .tech-logo {
    width: 2.2rem;
    height: 2.2rem;
    object-fit: contain;
  }

  .tech-card h2 {
    margin: 0;
    color: var(--text-strong);
    font-size: 1rem;
  }

  @media (min-width: 768px) {
    .tech-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .tech-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
