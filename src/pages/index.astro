---
import AboutSnapshot from '../components/AboutSnapshot.astro';
import BlogCard from '../components/BlogCard.astro';
import FocusAreaGrid from '../components/FocusAreaGrid.astro';
import HomeHero from '../components/HomeHero.astro';
import PageContainer from '../components/PageContainer.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { siteConfig } from '../data/site';
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';
import Main from '../layouts/Main.astro';
import { getBlogs } from '../utils/getBlogs';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const sortedBlogs = await getBlogs(locale);

const homePageMeta = {
  title: locale === 'zh' ? 'Ginlon | 工程、写作与长期主义实践' : 'Ginlon | Engineering, writing, and calm systems',
  description: t('homepage.hero.description'),
  ogType: 'website' as const,
};

const heroContent = {
  eyebrow: t('homepage.hero.eyebrow'),
  title: t('homepage.hero.title'),
  description: t('homepage.hero.description'),
  primaryCta: {
    href: getLocalizedPath(locale, 'blogs'),
    label: t('homepage.hero.primaryCta'),
  },
  secondaryCta: {
    href: getLocalizedPath(locale, 'about'),
    label: t('homepage.hero.secondaryCta'),
  },
};

const focusAreaContent = {
  eyebrow: t('homepage.focusAreas.eyebrow'),
  title: t('homepage.focusAreas.title'),
  description: t('homepage.focusAreas.description'),
  items: [
    {
      title: t('homepage.focusAreas.items.engineering.title'),
      description: t('homepage.focusAreas.items.engineering.description'),
      meta: t('homepage.focusAreas.items.engineering.meta'),
    },
    {
      title: t('homepage.focusAreas.items.systems.title'),
      description: t('homepage.focusAreas.items.systems.description'),
      meta: t('homepage.focusAreas.items.systems.meta'),
    },
    {
      title: t('homepage.focusAreas.items.writing.title'),
      description: t('homepage.focusAreas.items.writing.description'),
      meta: t('homepage.focusAreas.items.writing.meta'),
    },
  ],
};

const aboutSnapshotContent = {
  eyebrow: t('homepage.aboutSnapshot.eyebrow'),
  title: t('homepage.aboutSnapshot.title'),
  description: t('homepage.aboutSnapshot.description'),
  points: [
    t('homepage.aboutSnapshot.points.0'),
    t('homepage.aboutSnapshot.points.1'),
    t('homepage.aboutSnapshot.points.2'),
  ],
  cta: {
    href: getLocalizedPath(locale, 'about'),
    label: t('homepage.aboutSnapshot.cta'),
  },
};
---

<Main pageMeta={homePageMeta}>
  <PageContainer class="space-y-12 py-10 md:space-y-16 md:py-16">
    <HomeHero {...heroContent} />

    <FocusAreaGrid {...focusAreaContent} />

    <section class="space-y-6" aria-labelledby="selected-writing">
      <SectionHeader
        eyebrow={t('homepage.selectedWriting.eyebrow')}
        title={t('homepage.selectedWriting.title')}
        description={t('homepage.selectedWriting.description')}
      />

      <div class="grid gap-5">
        {
          sortedBlogs.slice(0, 3).map((blog) => (
            <BlogCard blog={blog} />
          ))
        }
      </div>
    </section>

    <AboutSnapshot {...aboutSnapshotContent} />

    <section class="space-y-6" aria-labelledby="contact-links">
      <SectionHeader
        eyebrow={t('homepage.contact.eyebrow')}
        title={t('homepage.contact.title')}
        description={t('homepage.contact.description')}
      />

      <div class="flex flex-wrap gap-3">
        {
          siteConfig.contactLinks.map((link) => (
            <a
              href={link.href}
              class="inline-flex rounded-full border border-[var(--surface-border)] bg-[var(--surface-bg-strong)] px-4 py-2 text-sm font-medium text-[var(--text-strong)] transition hover:border-[var(--accent)] hover:text-[var(--accent)]"
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noreferrer' : undefined}
            >
              {link.label[locale]}
            </a>
          ))
        }
      </div>
    </section>
  </PageContainer>
</Main>
