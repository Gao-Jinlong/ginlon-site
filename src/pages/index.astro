---
import { l, t } from 'astro-i18n';
import Main from '../layouts/Main.astro';
import BriefText from '../components/BriefText.vue';
import { Image } from 'astro:assets';
import { getBlogs } from '../utils/getBlogs';
import { dayjs, format } from '../utils/dayjs';
const sortedBlogs = await getBlogs();
const routeName = 'blogs';
---

<Main pageTitle="Home">
  <div class="profile-section">
    <Image
      transition:name="avatar"
      class="profile-avatar"
      src="https://gravatar.com/avatar/cd5878de1abed51ad8d91f354427a98647e470547b2dc1c714a43f76d7b8d025?v=1754772938000&size=512&d=initials"
      alt="Avatar"
      width={124}
      height={124}
      loading="eager"
    />

    <div class="profile-info">
      <h1 class="profile-title">
        {t('homepage.hello')}
      </h1>
      <h2 class="profile-subtitle">
        <BriefText
          briefs={[
            t('homepage.briefs.0'),
            t('homepage.briefs.1'),
            t('homepage.briefs.2'),
          ]}
          client:load
        />
      </h2>
      <p class="profile-slogan">
        {t('homepage.personalMission')}
      </p>
    </div>
  </div>

  <div class="featured-blogs-section">
    <div class="section-header">
      <h3 class="section-title">
        {t('homepage.featuredBlogs.title')}
      </h3>
      <p class="section-description">
        {t('homepage.featuredBlogs.brief')}
      </p>
    </div>

    <div class="blogs-container">
      {
        sortedBlogs.slice(0, 3).map(blog => (
          <a
            class="blog-card"
            href={l(
              `${import.meta.env.BASE_URL}${routeName}/${blog.data.permalink}`,
            )}
          >
            <div class="blog-card-inner">
              <h4 class="blog-title">
                {blog.data.draft ? '🚧' : ''} {blog.data.title}
              </h4>
              {blog.data.createdAt && (
                <span class="blog-date">
                  {dayjs(blog.data.createdAt).format(format)}
                </span>
              )}
            </div>
          </a>
        ))
      }
    </div>

    <div class="view-more">
      <a href={`${import.meta.env.BASE_URL}blogs`} class="view-more-link">
        查看更多
      </a>
    </div>
  </div>
</Main>

<style>
  .profile-section {
    @apply my-6;
    @apply flex flex-wrap items-center gap-8 border border-gray-100 bg-white/90 p-6 shadow-sm backdrop-blur-sm transition-all duration-200 hover:border-gray-200 hover:shadow-md dark:border-gray-800 dark:bg-gray-900/90 dark:hover:border-gray-700;
  }

  .profile-avatar {
    @apply h-32 w-32 rounded-full object-cover transition-transform duration-200 hover:scale-105 max-md:h-24 max-md:w-24;
  }

  .profile-info {
    @apply min-w-[300px] flex-1 max-[410px]:mt-4;
  }

  .profile-title {
    @apply text-2xl font-bold text-gray-900 dark:text-gray-100 sm:text-4xl;
  }

  .profile-subtitle {
    @apply mt-2 text-xl text-gray-700 dark:text-gray-300 sm:text-2xl;
  }

  .profile-slogan {
    @apply text-wrap pt-1 text-sm text-gray-600 dark:text-gray-400 sm:text-base;
  }

  .featured-blogs-section {
    @apply border border-gray-100 bg-white/60 p-6 shadow-sm backdrop-blur-sm transition-all duration-200 hover:border-gray-200 hover:shadow-md dark:border-gray-800 dark:bg-gray-900/90 dark:hover:border-gray-700;
  }

  .section-header {
    @apply p-6 transition-all duration-200 dark:border-gray-800;
  }

  .section-title {
    @apply text-xl font-medium text-gray-900 dark:text-gray-100;
  }

  .section-description {
    @apply mt-2 text-sm text-gray-600 dark:text-gray-400;
  }

  .blogs-container {
    @apply space-y-4;
  }

  .blog-card {
    @apply block w-full transition-all duration-200;
  }

  .blog-card-inner {
    @apply rounded-lg border border-gray-100 bg-white/90 p-4 shadow-sm backdrop-blur-sm transition-all duration-200 hover:border-gray-200 hover:shadow-md dark:border-gray-800 dark:bg-gray-900/90 dark:hover:border-gray-700;
  }

  .blog-title {
    @apply text-base font-medium text-gray-900 dark:text-gray-100;
  }

  .blog-date {
    @apply mt-1 block text-xs text-gray-500 dark:text-gray-500;
  }

  .view-more {
    @apply mt-6 text-right;
  }

  .view-more-link {
    @apply inline-block rounded-lg border border-gray-100 bg-white/90 px-4 py-2 text-sm text-gray-600 shadow-sm backdrop-blur-sm transition-all duration-200 hover:border-gray-200 hover:text-blue-600 hover:shadow-md dark:border-gray-800 dark:bg-gray-900/90 dark:text-gray-400 dark:hover:border-gray-700 dark:hover:text-blue-400;
  }
</style>
