---
import ArticleCard from '../components/site/ArticleCard.astro';
import PageSection from '../components/site/PageSection.astro';
import SectionHeading from '../components/site/SectionHeading.astro';
import { siteConfig } from '../data/site';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getBlogs } from '../utils/getBlogs';

const articles = await getBlogs('zh');
// 优先显示精选文章（frontmatter 中 featured: true），如果没有则取最新 3 篇
const featuredArticles = articles.filter((article) => article.featured);
const selectedWriting = featuredArticles.length > 0 ? featuredArticles : articles.slice(0, 3);

const pageMeta = {
  title: 'Ginlon | 写作与工程实践',
  description: '关于工程、写作与长期主义实践的中文写作站点。',
};
---

<SiteLayout pageMeta={pageMeta}>
  <section class="home-hero">
    <p class="hero-eyebrow">关于我</p>
    <div class="hero-profile">
      <img src="https://bucket.ginlon.site/avatar_512.png" alt="Ginlon" class="hero-avatar" />
      <div class="hero-profile-content">
        <h1 class="hero-title">Ginlon</h1>
        <p class="hero-tagline">
          全干工程师，写作爱好者。<br />
          相信工程是理解世界的方式，写作是理解自己的方式。
        </p>
      </div>
    </div>
  </section>

  <PageSection narrow={false} id="home-selected-writing">
    <SectionHeading
      eyebrow="精选写作"
      title="写作"
      description="挑三篇最近的文章，快速进入我这段时间关心的问题。"
    />

    <div class="article-list">
      {selectedWriting.map((article) => <ArticleCard article={article} />)}
    </div>
  </PageSection>

  <PageSection narrow={false} id="home-current-focus">
    <SectionHeading
      eyebrow="当前关注"
      title="当前关注"
      description="最近在推进的三个长期主题。"
    />

    <ul class="focus-list">
      <li>
        <h3>Harness Engineering</h3>
        <p>探索在 Agent 优先时代如何有效利用 AI 进行软件工程实践。</p>
      </li>
      <li>
        <h3>写作流程系统化</h3>
        <p>通过固定节奏积累选题、草稿和复盘，让写作成为长期实践而非灵感事件。</p>
      </li>
      <li>
        <h3>长期主义执行力</h3>
        <p>关注可持续投入，把注意力放在十年后仍然有价值的能力上。</p>
      </li>
    </ul>
  </PageSection>

  <!-- <PageSection narrow={false} id="home-about-preview">
    <SectionHeading
      eyebrow="关于"
      title="关于我"
      description="期望在 AI 时代实现自我价值的工程师"
    />

    <div class="about-preview">
      <p>
        我的追求是构建一个对人类有价值的工程，然后将经验传递给后来者。
      </p>
      <div class="about-links">
        <a href="/about">阅读完整介绍</a>
        {
          siteConfig.contactLinks.map((link) => (
            <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noreferrer' : undefined}>
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
  </PageSection> -->
</SiteLayout>

<style>
  .home-hero {
    border: 1px solid var(--surface-border);
    border-radius: var(--radius-m);
    background: var(--surface-bg-strong);
    padding: 1.5rem;
    display: grid;
    gap: 0.75rem;
    max-width: var(--shell-width);
    margin: 0 auto;
  }

  .hero-eyebrow {
    margin: 0;
    color: var(--accent);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .hero-profile {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .hero-avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--surface-border);
    box-shadow: var(--shadow-soft);
  }

  .hero-profile-content {
    display: grid;
    gap: 0.5rem;
    flex: 1;
  }

  .hero-title {
    margin: 0;
    color: var(--text-strong);
    font-size: clamp(2rem, 1.2rem + 2vw, 3.2rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .hero-tagline {
    margin: 0;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.9;
    max-width: 38rem;
  }

  .article-list {
    display: grid;
    gap: 0.9rem;
  }

  .focus-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.75rem;
  }

  .focus-list li {
    border: 1px solid var(--surface-border);
    border-radius: var(--radius-m);
    background: var(--surface-bg);
    padding: 0.95rem;
    display: grid;
    gap: 0.4rem;
  }

  .focus-list h3 {
    margin: 0;
    font-size: 1.03rem;
    color: var(--text-strong);
  }

  .focus-list p {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .about-preview {
    border: 1px solid var(--surface-border);
    border-radius: var(--radius-m);
    background: var(--surface-bg);
    padding: 1rem;
    display: grid;
    gap: 0.75rem;
  }

  .about-preview p {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.8;
  }

  .about-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.8rem;
  }

  .about-links a {
    color: var(--text-strong);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .about-links a:hover {
    color: var(--accent);
  }

  @media (max-width: 767px) {
    .home-hero {
      padding: 1rem;
    }

    .hero-profile {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .hero-avatar {
      width: 80px;
      height: 80px;
    }
  }

  @media (min-width: 768px) {
    .home-hero {
      padding: 1.5rem 2rem;
    }
  }
</style>
