---
import { l, t } from 'astro-i18n';
import Main from '../layouts/Main.astro';
import SectionNavigation from '../components/SectionNavigation.astro';
import BriefText from '../components/BriefText.vue';

import { Image } from 'astro:assets';
import { getBlogs } from '../utils/getBlogs';

const sortedBlogs = await getBlogs();

const routeName = t('blogs.titre');
---

<Main pageTitle="Home">
  <div class="animate flex flex-wrap items-center pb-8 md:space-x-8">
    <Image
      class="h-[124px] w-[124px] rounded-full object-cover max-md:h-24 max-md:w-24"
      src="https://avatars.githubusercontent.com/u/41514616?v=4"
      alt="Avatar"
      width={124}
      height={124}
      loading="eager"
    />

    <div class="min-w-[300px] flex-1 max-[410px]:mt-4 md:ml-4">
      <h1
        class="ml-4 text-2xl font-bold text-gray-900 dark:text-gray-100 sm:text-4xl"
      >
        {t('homepage.hello')}
        {}
      </h1>
      <h2
        class="ml-4 mt-2 h-4 text-xl text-gray-700 dark:text-gray-300 sm:text-2xl"
      >
        <BriefText
          briefs={[
            t('homepage.briefs.0'),
            t('homepage.briefs.1'),
            t('homepage.briefs.2'),
          ]}
          client:load
        />
      </h2>
      <p
        class="ml-4 mt-4 text-wrap text-sm text-gray-600 dark:text-gray-400 sm:text-base"
      >
        {t('homepage.slogan')}
      </p>
    </div>
  </div>
  <SectionNavigation />
  <div class="animate mt-12">
    <h3 class="mb-4 text-3xl text-gray-900 dark:text-gray-100">
      {t('homepage.featuredBlogs.title')}
    </h3>

    <p class="mb-8 text-gray-600 dark:text-gray-400">
      {t('homepage.featuredBlogs.brief')}
    </p>
  </div>

  <div class="animate w-full text-right text-gray-400">
    <a href={`${import.meta.env.BASE_URL}blogs`}>查看更多</a>
  </div>
  <ol class="animate space-y-4">
    {
      sortedBlogs.slice(0, 3).map(blog => (
        <li class="border-b border-gray-200 dark:border-gray-700">
          <a
            class="block py-4 text-gray-900 transition-opacity duration-200 ease-in-out hover:opacity-70 dark:text-gray-100"
            href={l(
              `${import.meta.env.BASE_URL}${routeName}/${blog.data.permalink}`,
            )}
          >
            {blog.data.title}
          </a>
        </li>
      ))
    }
  </ol>
</Main>

<style>
  .floating-span {
    display: inline-block;
  }
  #copyLinkContainer.hidden {
    display: none;
  }
</style>
