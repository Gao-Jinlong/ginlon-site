---
import { render } from 'astro:content';
import ArticleHeader from '../../../components/site/ArticleHeader.astro';
import ArticleAside from '../../../components/site/ArticleAside.astro';
import ArticlePager from '../../../components/site/ArticlePager.astro';
import ArticleTocDrawer from '../../../components/site/ArticleTocDrawer.astro';
import Shell from '../../../components/site/Content.astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import 'viewerjs/dist/viewer.css';
import { siteConfig } from '../../../data/site';
import { dayjs, format } from '../../../utils/dayjs';
import { getColumns, getColumnArticle } from '../../../utils/getColumns';

function toIsoString(value?: string | Date) {
  if (!value) return undefined;
  const parsed = value instanceof Date ? value : new Date(value);
  return Number.isNaN(parsed.getTime()) ? undefined : parsed.toISOString();
}

export async function getStaticPaths() {
  const columns = await getColumns();
  const paths = [];

  for (const col of columns) {
    const { getColumnBySlug } = await import('../../../utils/getColumns');
    const detail = await getColumnBySlug(col.slug);
    if (!detail) continue;

    for (const article of detail.articles) {
      paths.push({
        params: { slug: col.slug, article: article.slug },
      });
    }
  }

  return paths;
}

const { slug, article: articleSlug } = Astro.params;
const detail = await getColumnArticle(slug!, articleSlug!);

if (!detail) {
  return Astro.redirect('/columns');
}

const { Content, headings } = await render(detail.content);
const filteredHeadings = headings.filter((h: { depth: number }) => h.depth >= 2 && h.depth <= 4);

const summary = detail.subtitle;
const publishedLabel = dayjs(detail.createdAt).format(format);
const categoryLabel = '工程 · 长读';

const publishedTime = toIsoString(detail.createdAt);
const modifiedTime = toIsoString(detail.updatedAt);
const pageMeta = {
  title: `${detail.title} | ${detail.column.title} | ${siteConfig.name}`,
  description: summary || detail.column.description,
  ogType: 'article' as const,
  ogImage: siteConfig.articleOgImage,
  ...(detail.tags ? { tags: detail.tags } : {}),
  ...(publishedTime ? { publishedTime } : {}),
  ...(modifiedTime ? { modifiedTime } : {}),
};
---

<SiteLayout pageMeta={pageMeta}>
  <article>
    <Shell as="div">
      <ArticleHeader
        title={detail.title}
        summary={summary}
        publishedLabel={publishedLabel}
        publishedAtIso={publishedTime}
        lastModifiedIso={modifiedTime}
        tags={detail.tags}
        poster={detail.poster}
        categoryLabel={categoryLabel}
        column={{ title: detail.column.title, slug: slug! }}
      />

      <hr class="article-rule" />

      <div class="article-body reading-center">
        <Content />
      </div>

      <hr class="article-rule" />

      <ArticlePager
        prev={detail.prev ? { slug: `/columns/${slug}/${detail.prev.slug}`, title: detail.prev.title } : undefined}
        next={detail.next ? { slug: `/columns/${slug}/${detail.next.slug}`, title: detail.next.title } : undefined}
      />
    </Shell>

    <ArticleAside
      headings={filteredHeadings}
      column={{
        title: detail.column.title,
        slug: slug!,
        articles: detail.articles.map((a) => ({ slug: a.slug, title: a.title })),
        currentSlug: articleSlug!,
      }}
    />
    <ArticleTocDrawer headings={filteredHeadings} buttonLabel="目录" />
  </article>
</SiteLayout>

<style>
  .article-rule {
    height: 1px;
    border: 0;
    background: var(--hairline);
    margin: 0;
    max-width: var(--reading-width);
    margin-inline: auto;
  }

  .reading-center {
    max-width: var(--reading-width);
    margin-inline: auto;
    padding-block: 32px 56px;
  }

  pre.mermaid {
    cursor: zoom-in;
    transition: background-color 0.15s ease;
  }

  pre.mermaid:hover {
    background-color: rgba(125, 125, 125, 0.08);
  }

  [data-theme='dark'] pre.mermaid:hover {
    background-color: rgba(255, 255, 255, 0.06);
  }

  .mermaid-img {
    max-width: 100%;
    height: auto;
  }

  @media (max-width: 720px) {
    .reading-center {
      padding-block: 24px 36px;
    }
  }
</style>

<script>
  // TOC 滚动高亮：高亮「当前阅读位置上方最近的标题」对应项。
  // 用 scroll + getBoundingClientRect 直接计算，比 IntersectionObserver 更可控、
  // 无 rootMargin 语义陷阱。哨兵线位于视口顶部下方 SENTINEL_PX 处（避开 sticky header）。
  let tocCleanup: (() => void) | null = null;
  let lastActiveId: string | null = null;

  document.addEventListener('astro:page-load', () => {
    tocCleanup?.();
    tocCleanup = null;
    lastActiveId = null;

    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
    if (links.length === 0) return;

    const headings: { id: string; el: HTMLElement; link: HTMLAnchorElement }[] = [];
    links.forEach((link) => {
      const id = link.getAttribute('href')?.slice(1);
      if (!id) return;
      const el = document.getElementById(id);
      if (el) headings.push({ id, el, link });
    });
    if (headings.length === 0) return;

    const SENTINEL_PX = 100;
    let ticking = false;

    const setActive = (id: string) => {
      if (id === lastActiveId) return;
      links.forEach((l) => l.classList.remove('is-active'));
      const target = headings.find((h) => h.id === id);
      target?.link.classList.add('is-active');
      lastActiveId = id;
    };

    const update = () => {
      let current = headings[0]!.id;
      for (const h of headings) {
        if (h.el.getBoundingClientRect().top <= SENTINEL_PX) {
          current = h.id;
        } else {
          break;
        }
      }
      setActive(current);
      ticking = false;
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);

    tocCleanup = () => {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onScroll);
    };
  });
</script>

<script>
  import { svgXmlToDataUrl, injectSvgBackground } from '../../../utils/mermaidPreview';
  import type Viewer from 'viewerjs';
  // 图片预览：点击正文图片放大查看（Viewer.js）
  let articleViewer: Viewer | null = null;
  document.addEventListener('astro:page-load', async () => {
    const body = document.querySelector('.article-body');
    if (!(body instanceof HTMLElement)) return;

    // 销毁上一页遗留的实例，避免重复绑定
    articleViewer?.destroy();
    articleViewer = null;

    const { default: Viewer } = await import('viewerjs');
    articleViewer = new Viewer(body, {
      toolbar: {
        zoomIn: true,
        zoomOut: true,
        oneToOne: true,
        reset: true,
        prev: true,
        play: false,
        next: true,
        rotateLeft: true,
        rotateRight: true,
        flipHorizontal: true,
        flipVertical: true,
      },
      title: false,
    });
  });

  // mermaid 图预览：astro-mermaid 渲染完成后，把内联 SVG 换成 <img>，
  // 复用上面同一组 Viewer 实例（articleViewer），让 mermaid 进图片预览队列。
  let mermaidObserver: MutationObserver | null = null;
  document.addEventListener('astro:page-load', () => {
    const body = document.querySelector('.article-body');
    if (!(body instanceof HTMLElement)) return;

    mermaidObserver?.disconnect();
    mermaidObserver = null;

    const wrapMermaidImage = (pre: HTMLPreElement): boolean => {
      const svg = pre.querySelector('svg');
      if (!svg) return false; // 渲染失败（astro-mermaid 插了错误 div，无 svg）→ 不动
      const clone = svg.cloneNode(true) as SVGSVGElement;
      // mermaid 的 svg 用 width="100%"+viewBox 但无显式 height，
      // 序列化成 <img> 后固有尺寸会失真（变成很小的默认值）。
      // 这里据 viewBox 设回像素宽高，让 <img> 按正确比例渲染。
      const vb = clone.getAttribute('viewBox');
      const m = vb ? vb.match(/\S+\s+\S+\s+([\d.]+)\s+([\d.]+)/) : null;
      const vbW = m?.[1];
      const vbH = m?.[2];
      if (vbW && vbH) {
        clone.setAttribute('width', vbW);
        clone.setAttribute('height', vbH);
      }
      let xml = new XMLSerializer().serializeToString(clone);
      // mermaid SVG 透明背景：放进 Viewer 浮层会透出底部文章内容、影响阅读。
      // 注入一个覆盖整图的主题色背景 rect（与 theme.css 的 --page-bg 对应）。
      if (vbW && vbH) {
        const isDark =
          document.documentElement.getAttribute('data-theme') === 'dark';
        const bg = isDark ? '#131714' : '#faf8f3';
        xml = injectSvgBackground(xml, vbW, vbH, bg);
      }
      const img = document.createElement('img');
      img.src = svgXmlToDataUrl(xml);
      img.alt = 'Mermaid 图表';
      img.className = 'mermaid-img';
      img.loading = 'lazy';
      pre.replaceChildren(img); // <pre> 保留作布局容器
      return true;
    };

    const needsWrap = (pre: Element): boolean =>
      pre.hasAttribute('data-processed') &&
      !!pre.querySelector('svg') &&
      !pre.querySelector('img.mermaid-img');

    const scanAndWrap = () => {
      let changed = false;
      document.querySelectorAll('pre.mermaid').forEach((pre) => {
        if (needsWrap(pre)) {
          changed = wrapMermaidImage(pre as HTMLPreElement) || changed;
        }
      });
      if (changed) articleViewer?.update(); // 让 Viewer 收录新 <img>
    };

    scanAndWrap(); // 快路径：扫一遍已就绪的

    // 监听 data-processed：astro-mermaid 渲染完 svg 后会设它；
    // 主题切换时它会先移除再重设 → 重新封装新主题 svg（去重靠 needsWrap 的 img 判断）
    mermaidObserver = new MutationObserver(scanAndWrap);
    mermaidObserver.observe(body, {
      childList: true,
      subtree: true,
      attributes: true,
      attributeFilter: ['data-processed'],
    });
  });
</script>
