---
import BlogCard from '../../components/BlogCard.astro';
import PageContainer from '../../components/PageContainer.astro';
import PageIntro from '../../components/PageIntro.astro';
import Tabs from '../../components/Tabs.astro';
import { getLocaleFromUrl } from '../../i18n/utils';
import Main from '../../layouts/Main.astro';
import { getBlogs, type BlogCategory } from '../../utils/getBlogs';
import enCopy from './_i18n/en.json';
import zhCopy from './_i18n/zh.json';

interface BlogData {
  data: {
    title: string;
    permalink: string;
    createdAt: string;
    description?: string;
    tags?: string[];
    draft?: boolean;
    category: BlogCategory;
    poster?: string;
    subtitle?: string;
  };
}

const locale = getLocaleFromUrl(Astro.url);
const copy = locale === 'zh' ? zhCopy : enCopy;
const blogs = (await getBlogs(locale)) as BlogData[];
const techBlogs = blogs.filter((blog) => blog.data.category === 'tech');
const noteBlogs = blogs.filter((blog) => blog.data.category === 'note');

const categories = [
  {
    id: 'tech',
    title: copy.categories.tech.title,
    description: copy.categories.tech.description,
    icon: copy.categories.tech.icon,
  },
  {
    id: 'note',
    title: copy.categories.note.title,
    description: copy.categories.note.description,
    icon: copy.categories.note.icon,
  },
];
---

<Main
  pageMeta={{
    title: locale === 'zh' ? '写作 | Ginlon' : 'Writing | Ginlon',
    description: copy.subtitle,
  }}
>
  <PageContainer class="space-y-8 py-10 md:space-y-10 md:py-14">
    <PageIntro eyebrow={copy.eyebrow} title={copy.pageName} description={copy.subtitle} />

    <section class="writing-panel">
      <Tabs tabs={categories} />

      <div class="tab-content">
        {
          categories.map((category, index) => (
            <section class="tab-panel" data-category={category.id} data-active={index === 0}>
              <p class="category-description">{category.description}</p>

              <div class="blog-list">
                {(category.id === 'tech' ? techBlogs : noteBlogs).map((blog) => (
                  <BlogCard blog={blog} />
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </section>
  </PageContainer>
</Main>

<style>
  .writing-panel {
    border: 1px solid var(--surface-border);
    background: var(--surface-bg);
    padding: 1.1rem;
    box-shadow: var(--shadow-soft);
  }

  .tab-content {
    padding-top: 0.5rem;
  }

  .tab-panel {
    display: none;
  }

  .tab-panel[data-active='true'] {
    display: block;
  }

  .category-description {
    margin: 0 0 1.35rem;
    color: var(--text-muted);
    line-height: 1.75;
  }

  .blog-list {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .writing-panel {
      padding: 1.4rem;
    }
  }
</style>
