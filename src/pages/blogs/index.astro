---
import { t, l } from 'astro-i18n';
import Main from '../../layouts/Main.astro';
import { getBlogs } from '../../utils/getBlogs';
import { format, dayjs } from '../../utils/dayjs';

interface BlogData {
  data: {
    title: string;
    permalink: string;
    createdAt: string;
    description?: string;
    tags?: string[];
    draft?: boolean;
  };
}

const sortedBlogs = (await getBlogs()) as BlogData[];

const drafts = sortedBlogs.filter(blog => blog.data.draft);
const published = sortedBlogs.filter(blog => !blog.data.draft);
const routeName = 'blogs';
---

<Main pageTitle="blogs">
  <div class="blogs-section">
    <div class="section-header">
      <h1 class="section-title">{t('blogs.pageName')}</h1>
      <p class="section-description">{t('blogs.subtitle')}</p>
    </div>

    <div class="blogs-container">
      {
        [...drafts, ...published].map(blog => (
          <a
            class="blog-card"
            href={l(
              `${import.meta.env.BASE_URL}${routeName}/${blog.data.permalink}`,
            )}
          >
            <div class="blog-card-inner">
              <h2 class="blog-title">{blog.data.draft && '🚧'}{blog.data.title}</h2>
              {blog.data.description && (
                <p class="blog-description">{blog.data.description}</p>
              )}
              <div class="blog-meta">
                {blog.data.createdAt && (
                  <span class="blog-date">
                    {dayjs(blog.data.createdAt).format(format)}
                  </span>
                )}
                {blog.data.tags && (
                  <div class="blog-tags">
                    {blog.data.tags.map(tag => (
                      <span class="blog-tag">{tag}</span>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Main>

<style>
  .blogs-section {
    @apply mx-auto mt-6 max-w-4xl bg-white/80 p-6 dark:border-gray-800 dark:bg-gray-900/90;
  }

  .section-header {
    @apply p-4 shadow-sm backdrop-blur-sm transition-all duration-200;
  }

  .section-title {
    @apply text-xl font-medium text-gray-900 dark:text-gray-100;
  }

  .section-description {
    @apply mt-2 text-sm text-gray-600 dark:text-gray-400;
  }

  .blogs-container {
    @apply space-y-3;
  }

  .blog-card {
    @apply block w-full transition-all duration-200;
  }

  .blog-card-inner {
    @apply rounded-lg border border-gray-100 bg-white/90 p-4 shadow-sm backdrop-blur-sm transition-all duration-200 hover:border-gray-200 hover:bg-gray-50 hover:shadow-md dark:border-gray-800 dark:bg-gray-900/90 dark:hover:border-gray-700 dark:hover:bg-gray-800/60;
  }

  .blog-title {
    @apply text-base font-medium text-gray-900 dark:text-gray-100;
  }

  .blog-description {
    @apply mt-1.5 text-sm text-gray-600 dark:text-gray-400;
  }

  .blog-meta {
    @apply mt-2 flex flex-wrap items-center gap-3;
  }

  .blog-date {
    @apply text-xs text-gray-500 dark:text-gray-500;
  }

  .blog-tags {
    @apply flex flex-wrap gap-2;
  }

  .blog-tag {
    @apply rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600 transition-colors hover:bg-gray-200 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-gray-700;
  }
</style>
