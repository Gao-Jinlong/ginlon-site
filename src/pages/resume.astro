---
import PageContainer from '../components/PageContainer.astro';
import { resumePageContent } from '../data/resume';
import Main from '../layouts/Main.astro';

const pageMeta = {
  title: '高金龙 | 简历',
  description: '高金龙的个人简历页面，聚焦 Web 可视化、地图应用与工程化交付。',
  ogType: 'profile' as const,
  alternates: [],
  robots: 'noindex, nofollow',
};

const { header, summary, capabilityGroups, experience, projects } =
  resumePageContent;
---

<Main pageMeta={pageMeta}>
  <PageContainer class="resume-page">
    <div class="resume-shell animate">
      <header class="hero-card" aria-labelledby="resume-name">
        <div class="hero-copy">
          <p class="eyebrow">个人简历</p>
          <h1 id="resume-name">{header.name}</h1>
          <p class="hero-title">{header.title}</p>
          <p class="hero-tagline">{header.tagline}</p>
        </div>

        <div class="contact-row" aria-label="联系方式">
          <a class="contact-link" href={`mailto:${header.email}`}>
            <span class="contact-label">邮箱</span>
            <span>{header.email}</span>
          </a>
          <a
            class="contact-link"
            href={header.website.href}
            target="_blank"
            rel="noreferrer"
          >
            <span class="contact-label">网站</span>
            <span>{header.website.label}</span>
          </a>
        </div>
      </header>

      <section class="resume-section" aria-labelledby="resume-summary">
        <div class="section-heading">
          <p class="section-kicker">概述</p>
          <h2 id="resume-summary">个人概述</h2>
        </div>
        <p class="summary-text">{summary}</p>
      </section>

      <section class="resume-section" aria-labelledby="resume-capabilities">
        <div class="section-heading">
          <p class="section-kicker">能力</p>
          <h2 id="resume-capabilities">能力结构</h2>
        </div>

        <div class="capability-list">
          {
            capabilityGroups.map(group => (
              <article class="capability-card">
                <h3>{group.title}</h3>
                <ul class="pill-list">
                  {group.items.map(item => (
                    <li>{item}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </section>

      <section class="resume-section" aria-labelledby="resume-experience">
        <div class="section-heading">
          <p class="section-kicker">经历</p>
          <h2 id="resume-experience">工作经历</h2>
        </div>

        <div class="timeline-list">
          {
            experience.map(item => (
              <article class="timeline-card">
                <div class="timeline-topline">
                  <p class="period-badge">{item.period}</p>
                  <div>
                    <h3>{item.company}</h3>
                    <p class="role-label">{item.role}</p>
                  </div>
                </div>
                <p class="card-summary">{item.summary}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="resume-section" aria-labelledby="resume-projects">
        <div class="section-heading">
          <p class="section-kicker">项目</p>
          <h2 id="resume-projects">核心项目</h2>
        </div>

        <div class="timeline-list">
          {
            projects.map(project => (
              <article class="timeline-card">
                <div class="timeline-topline">
                  <p class="period-badge">{project.period}</p>
                  <div>
                    <h3>{project.title}</h3>
                    <p class="card-summary project-summary">
                      {project.summary}
                    </p>
                  </div>
                </div>

                <ul class="highlight-list">
                  {project.highlights.map(highlight => (
                    <li>{highlight}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </section>
    </div>
  </PageContainer>
</Main>

<style>
  .resume-page {
    padding-top: 2.5rem;
    padding-bottom: 4rem;
  }

  .resume-shell {
    width: min(100%, 46rem);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .hero-card,
  .resume-section,
  .capability-card,
  .timeline-card {
    border: 1px solid var(--surface-border);
    background: var(--surface-bg);
    box-shadow: var(--shadow-soft);
    backdrop-filter: blur(18px);
  }

  .hero-card,
  .resume-section {
    border-radius: 1.75rem;
  }

  .hero-card {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 1.5rem;
  }

  .eyebrow,
  .section-kicker,
  .contact-label,
  .period-badge {
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .eyebrow,
  .section-kicker {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
  }

  .hero-copy h1,
  .section-heading h2,
  .timeline-card h3,
  .capability-card h3 {
    margin: 0;
    color: var(--text-strong);
  }

  .hero-copy h1 {
    margin-top: 0.35rem;
    font-size: clamp(2rem, 5vw, 2.8rem);
    line-height: 1.05;
  }

  .hero-title {
    margin: 0.55rem 0 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-strong);
  }

  .hero-tagline,
  .summary-text,
  .card-summary,
  .role-label,
  .highlight-list li {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.75;
  }

  .hero-tagline {
    margin-top: 0.75rem;
    max-width: 34rem;
  }

  .contact-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .contact-link {
    min-width: 0;
    display: inline-flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--surface-border);
    border-radius: 1rem;
    background: var(--surface-bg-strong);
    transition:
      border-color 180ms ease,
      transform 180ms ease,
      color 180ms ease;
  }

  .contact-link:hover {
    border-color: color-mix(in srgb, var(--accent) 36%, var(--surface-border));
    color: var(--accent);
    transform: translateY(-1px);
  }

  .contact-label {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .resume-section {
    padding: 1.35rem;
  }

  .resume-section + .resume-section {
    position: relative;
  }

  .resume-section + .resume-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 1.35rem;
    right: 1.35rem;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in srgb, var(--accent) 18%, var(--surface-border)),
      transparent
    );
  }

  .section-heading {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 1rem;
  }

  .section-heading h2 {
    font-size: 1.2rem;
  }

  .capability-list,
  .timeline-list {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .capability-card,
  .timeline-card {
    border-radius: 1.25rem;
    padding: 1rem;
  }

  .capability-card h3,
  .timeline-card h3 {
    font-size: 1rem;
    line-height: 1.5;
  }

  .pill-list,
  .highlight-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 0.85rem;
  }

  .pill-list li {
    padding: 0.42rem 0.75rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--text-strong);
    font-size: 0.92rem;
    line-height: 1.4;
  }

  .timeline-topline {
    display: grid;
    gap: 0.75rem;
    align-items: start;
  }

  .period-badge {
    width: fit-content;
    margin: 0;
    padding: 0.32rem 0.65rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .role-label,
  .project-summary {
    margin-top: 0.3rem;
  }

  .card-summary {
    margin-top: 0.9rem;
  }

  .highlight-list {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    margin-top: 1rem;
  }

  .highlight-list li {
    position: relative;
    padding-left: 1rem;
  }

  .highlight-list li::before {
    content: '';
    position: absolute;
    top: 0.8rem;
    left: 0;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 999px;
    background: var(--accent);
  }

  @media (min-width: 768px) {
    .resume-page {
      padding-top: 3.5rem;
      padding-bottom: 5rem;
    }

    .resume-shell {
      gap: 1.2rem;
    }

    .hero-card {
      padding: 1.9rem;
    }

    .resume-section {
      padding: 1.6rem;
    }

    .timeline-topline {
      grid-template-columns: auto 1fr;
      gap: 1rem;
    }
  }
</style>
