---
import PageContainer from '../components/PageContainer.astro';
import { resumePageContent } from '../data/resume';
import Main from '../layouts/Main.astro';

const pageMeta = {
  title: '高金龙 | 简历',
  description: '高金龙的个人简历页面，聚焦 Web 可视化、地图应用与工程化交付。',
  ogType: 'profile' as const,
  alternates: [],
  robots: 'noindex, nofollow',
};

const { header, summary, capabilityGroups, experience, projects } =
  resumePageContent;
---

<Main pageMeta={pageMeta}>
  <PageContainer class="resume-page">
    <div class="resume-shell animate">
      <header class="hero-card" aria-labelledby="resume-name">
        <div class="hero-copy">
          <p class="eyebrow">个人简历</p>
          <h1 id="resume-name">{header.name}</h1>
          <p class="hero-title">{header.title}</p>
          <p class="hero-tagline">{header.tagline}</p>
        </div>

        <div class="contact-row" aria-label="联系方式">
          <a class="contact-link" href={`mailto:${header.email}`}>
            <span class="contact-label">邮箱</span>
            <span>{header.email}</span>
          </a>
          <a
            class="contact-link"
            href={header.website.href}
            target="_blank"
            rel="noreferrer"
          >
            <span class="contact-label">网站</span>
            <span>{header.website.label}</span>
          </a>
        </div>
      </header>

      <section class="resume-section" aria-labelledby="resume-summary">
        <div class="section-heading">
          <p class="section-kicker">概述</p>
          <h2 id="resume-summary">个人概述</h2>
        </div>
        <p class="summary-text">{summary}</p>
      </section>

      <section class="resume-section" aria-labelledby="resume-capabilities">
        <div class="section-heading">
          <p class="section-kicker">能力</p>
          <h2 id="resume-capabilities">能力结构</h2>
        </div>

        <div class="capability-list">
          {
            capabilityGroups.map(group => (
              <article class="capability-card">
                <h3>{group.title}</h3>
                <ul class="pill-list">
                  {group.items.map(item => (
                    <li>{item}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </section>

      <section class="resume-section" aria-labelledby="resume-experience">
        <div class="section-heading">
          <p class="section-kicker">经历</p>
          <h2 id="resume-experience">工作经历</h2>
        </div>

        <div class="timeline-list">
          {
            experience.map(item => (
              <article class="timeline-card">
                <div class="timeline-topline">
                  <p class="period-badge">{item.period}</p>
                  <div>
                    <h3>{item.company}</h3>
                    <p class="role-label">{item.role}</p>
                  </div>
                </div>
                <p class="card-summary">{item.summary}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="resume-section" aria-labelledby="resume-projects">
        <div class="section-heading">
          <p class="section-kicker">项目</p>
          <h2 id="resume-projects">核心项目</h2>
        </div>

        <div class="timeline-list">
          {
            projects.map(project => (
              <article class="timeline-card">
                <div class="timeline-topline">
                  <p class="period-badge">{project.period}</p>
                  <div>
                    <h3>{project.title}</h3>
                    <p class="card-summary project-summary">
                      {project.summary}
                    </p>
                  </div>
                </div>

                <ul class="highlight-list">
                  {project.highlights.map(highlight => (
                    <li>{highlight}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </section>
    </div>
  </PageContainer>
</Main>

<style>
  .resume-page {
    padding-top: 2.5rem;
    padding-bottom: 4rem;
  }

  .resume-shell {
    width: min(100%, 66rem);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .hero-card {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.75rem;
    border: 1px solid color-mix(in srgb, var(--surface-border) 88%, white);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--surface-bg) 92%, white);
  }

  .eyebrow,
  .section-kicker,
  .contact-label,
  .period-badge {
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .eyebrow,
  .section-kicker {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
  }

  .hero-copy h1,
  .section-heading h2,
  .timeline-card h3,
  .capability-card h3 {
    margin: 0;
    color: var(--text-strong);
  }

  .hero-copy h1 {
    margin-top: 0.35rem;
    font-size: clamp(2rem, 5vw, 2.8rem);
    line-height: 1.05;
  }

  .hero-title {
    margin: 0.55rem 0 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-strong);
  }

  .hero-tagline,
  .summary-text,
  .card-summary,
  .role-label,
  .highlight-list li {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .hero-tagline {
    margin-top: 0.75rem;
    max-width: 42rem;
  }

  .contact-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem 1.5rem;
  }

  .contact-link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    padding: 0;
    border: none;
    background: transparent;
    transition:
      color 180ms ease;
  }

  .contact-link:hover {
    color: var(--accent);
  }

  .contact-label {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .resume-section {
    padding-top: 1.5rem;
    margin-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--surface-border) 92%, white);
  }

  .resume-section + .resume-section {
    margin-top: 1.75rem;
  }

  .section-heading {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 0.95rem;
  }

  .section-heading h2 {
    font-size: 1.15rem;
  }

  .capability-list {
    display: grid;
    gap: 1.15rem 2rem;
  }

  .timeline-list {
    display: flex;
    flex-direction: column;
    gap: 1.05rem;
  }

  .capability-card,
  .timeline-card {
    padding-top: 0.95rem;
    border-top: 1px solid color-mix(in srgb, var(--surface-border) 90%, white);
  }

  .capability-card h3,
  .timeline-card h3 {
    font-size: 1rem;
    line-height: 1.5;
  }

  .pill-list,
  .highlight-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 0.7rem;
  }

  .pill-list li {
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--surface-border) 88%, white);
    background: transparent;
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.4;
  }

  .timeline-topline {
    display: grid;
    gap: 0.75rem;
    align-items: start;
  }

  .period-badge {
    width: fit-content;
    margin: 0;
    padding: 0.18rem 0.45rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--surface-border) 88%, white);
    background: transparent;
    color: var(--text-muted);
    font-size: 0.7rem;
    font-weight: 600;
  }

  .role-label,
  .project-summary {
    margin-top: 0.3rem;
  }

  .card-summary {
    margin-top: 0.9rem;
  }

  .highlight-list {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin-top: 1rem;
  }

  .highlight-list li {
    position: relative;
    padding-left: 1rem;
  }

  .highlight-list li::before {
    content: '';
    position: absolute;
    top: 0.8rem;
    left: 0;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 999px;
    background: var(--accent);
  }

  @media (min-width: 768px) {
    .resume-page {
      padding-top: 3.5rem;
      padding-bottom: 5rem;
    }

    .capability-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .hero-card {
      padding: 2rem;
    }

    .resume-section {
      padding-top: 1.7rem;
      margin-top: 1.7rem;
    }

    .timeline-topline {
      grid-template-columns: auto 1fr;
      gap: 1rem;
    }
  }

  @media print {
    @page {
      size: A4 portrait;
      margin: 8mm;
    }

    :global(html),
    :global(body),
    :global(.site-body),
    :global(.site-shell),
    :global(.site-main) {
      background: #fff !important;
    }

    :global(body) {
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
      color: #0f172a;
      font-size: 11px;
    }

    :global(.grid-bg),
    :global(.site-glow),
    :global(.nav-shell),
    :global(.footer-shell) {
      display: none !important;
    }

    :global(.site-main) {
      padding: 0 !important;
    }

    .resume-page {
      max-width: none;
      padding: 0;
    }

    .resume-shell {
      width: 100%;
      max-width: none;
      display: grid;
      grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
      gap: 0.45rem;
      align-items: start;
    }

    .hero-card {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(14rem, 0.8fr);
      align-items: end;
      gap: 0.75rem;
      padding: 0.75rem 0.9rem;
    }

    .hero-card,
    .resume-section,
    .capability-card,
    .timeline-card,
    .contact-link {
      background: #fff !important;
      border: 1px solid rgba(15, 23, 42, 0.12);
      box-shadow: none;
      backdrop-filter: none;
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .hero-card,
    .resume-section {
      border-radius: 0.95rem;
    }

    .capability-card,
    .timeline-card,
    .contact-link {
      border-radius: 0.65rem;
    }

    .resume-section {
      padding: 0.7rem 0.85rem;
    }

    .eyebrow,
    .section-kicker,
    .contact-label,
    .period-badge {
      letter-spacing: 0.06em;
    }

    .eyebrow,
    .section-kicker,
    .contact-label {
      font-size: 0.62rem;
    }

    .hero-copy h1 {
      margin-top: 0.15rem;
      font-size: 1.95rem;
    }

    .hero-title {
      margin-top: 0.25rem;
      font-size: 0.9rem;
    }

    .hero-tagline,
    .summary-text,
    .card-summary,
    .role-label,
    .highlight-list li {
      font-size: 0.73rem;
      line-height: 1.35;
    }

    .hero-tagline {
      margin-top: 0.4rem;
      max-width: none;
    }

    .contact-row {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.35rem;
      align-self: stretch;
    }

    .contact-link {
      padding: 0.45rem 0.55rem;
      border: 1px solid rgba(15, 23, 42, 0.12);
      gap: 0.1rem;
      color: #0f172a;
      text-decoration: none;
    }

    .resume-section,
    .capability-card,
    .timeline-card,
    .contact-link,
    .pill-list li,
    .period-badge {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .section-heading {
      gap: 0.12rem;
      margin-bottom: 0.5rem;
    }

    .section-heading h2 {
      font-size: 0.95rem;
    }

    .capability-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.35rem;
    }

    .timeline-list {
      gap: 0.35rem;
    }

    .capability-card,
    .timeline-card {
      padding: 0.55rem 0.65rem;
    }

    .capability-card h3,
    .timeline-card h3 {
      font-size: 0.8rem;
      line-height: 1.25;
    }

    .pill-list {
      gap: 0.24rem;
      margin-top: 0.35rem;
    }

    .pill-list li,
    .period-badge {
      background: rgba(15, 23, 42, 0.06);
      color: #0f172a;
    }

    .pill-list li {
      padding: 0.14rem 0.34rem;
      font-size: 0.62rem;
      line-height: 1.2;
    }

    .timeline-topline {
      grid-template-columns: auto 1fr;
      gap: 0.4rem;
    }

    .period-badge {
      padding: 0.14rem 0.32rem;
      font-size: 0.62rem;
    }

    .role-label,
    .project-summary {
      margin-top: 0.1rem;
    }

    .card-summary {
      margin-top: 0.35rem;
    }

    .highlight-list {
      gap: 0.18rem;
      margin-top: 0.45rem;
    }

    .highlight-list li {
      padding-left: 0.58rem;
    }

    .highlight-list li::before {
      top: 0.48rem;
      width: 0.18rem;
      height: 0.18rem;
      background: rgba(15, 23, 42, 0.55);
    }
  }
</style>
