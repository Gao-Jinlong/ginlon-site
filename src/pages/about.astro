---
import PageSection from '../components/site/PageSection.astro';
import SectionHeading from '../components/site/SectionHeading.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const pageMeta = {
  title: '关于 | Ginlon',
  description: 'Ginlon — 关于工程、写作与长期主义实践的中文写作站点。',
};
---

<SiteLayout pageMeta={pageMeta}>
  <div class="about-page">
    <section class="about-hero">
      <p class="about-eyebrow">关于</p>
      <h1 class="about-title">Ginlon</h1>
      <p class="about-tagline">
        前端工程师，写作爱好者。<br />
        相信工程是理解世界的方式，写作是理解自己的方式。
      </p>
    </section>

    <PageSection>
      <SectionHeading eyebrow="观点" title="工作理念" />
      <div class="about-body">
        <p>
          我相信好的工程实践来自于对问题本质的追问，而非对技术趋势的追逐。
          写代码和写文章一样，都是在寻找最清晰的表达方式。
        </p>
        <p>
          我关注业务的本质结构，喜欢通过工程手段描述事物的构成和发展过程，
          享受系统迭代升级中解决问题的过程。
        </p>
      </div>
    </PageSection>

    <PageSection>
      <SectionHeading eyebrow="兴趣" title="阅读与生活" />
      <div class="about-body">
        <p>
          阅读是我获得不同人生体验的途径，也是认识自己的方式。
          喜欢极致的视听艺术，层层跌进的戏剧结构，声乐的极致震撼。
        </p>
        <p>
          旅行让我感受人文，看跨越时空亘古不变的土地，看太阳底下没有新鲜事的人间。
        </p>
      </div>
    </PageSection>

    <PageSection>
      <SectionHeading eyebrow="联系" title="找到我" />
      <div class="contact-links">
        <a href="https://github.com/gao-jinlong" target="_blank" rel="noreferrer" class="contact-link">
          GitHub
        </a>
        <a href="mailto:ginlon5241@gmail.com" class="contact-link">
          Email
        </a>
      </div>
    </PageSection>
  </div>
</SiteLayout>

<style>
  .about-page {
    max-width: var(--shell-width);
    margin: 0 auto;
    padding: 0 0.75rem;
    display: grid;
    gap: 2rem;
  }

  .about-hero {
    display: grid;
    gap: 0.75rem;
    padding: 1.5rem;
    border: 1px solid var(--surface-border);
    background: var(--surface-bg-strong);
    box-shadow: var(--shadow-soft);
  }

  .about-eyebrow {
    margin: 0;
    color: var(--accent);
    font-family: var(--font-sans);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .about-title {
    margin: 0;
    color: var(--text-strong);
    font-size: clamp(2rem, 1.2rem + 2vw, 3.2rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .about-tagline {
    margin: 0;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.9;
    max-width: 38rem;
  }

  .about-body {
    display: grid;
    gap: 0.75rem;
  }

  .about-body p {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.9;
    max-width: var(--reading-width);
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--surface-border);
    border-radius: 999px;
    background: var(--surface-bg);
    color: var(--accent);
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 150ms ease;
  }

  .contact-link:hover {
    background: var(--accent-soft);
  }

  @media (max-width: 767px) {
    .about-page {
      padding: 0 0.5rem;
    }

    .about-hero {
      padding: 1rem;
    }
  }
</style>
