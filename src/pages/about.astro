---
import enCommon from '../i18n/common/en.json';
import zhCommon from '../i18n/common/zh.json';
import PageContainer from '../components/PageContainer.astro';
import PageIntro from '../components/PageIntro.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { siteConfig } from '../data/site';
import { getLocaleFromUrl } from '../i18n/utils';
import Main from '../layouts/Main.astro';
import type { PageMeta } from '../types/seo';

const locale = getLocaleFromUrl(Astro.url);
const dictionary = locale === 'zh' ? zhCommon : enCommon;
const about = dictionary.about;
const pageMeta = (
  locale === 'zh'
    ? {
        title: '关于 Ginlon',
        description: '了解 Ginlon 的工作方式、价值观、兴趣方向与联系方式。',
        ogType: 'profile' as const,
      }
    : {
        title: 'About Ginlon',
        description: "Learn about Ginlon's working style, values, interests, and contact links.",
        ogType: 'profile' as const,
      }
) satisfies Partial<PageMeta>;
---

<Main pageMeta={pageMeta}>
  <PageContainer class="about-page">
    <PageIntro
      eyebrow={about.intro.eyebrow}
      title={about.intro.title}
      description={about.intro.description}
      class="about-intro"
    />

    <section class="about-hero">
      <div class="about-profile-card">
        <img src="/images/avatar.jpg" alt="Ginlon avatar" class="about-avatar" width="128" height="128" />
        <div class="about-profile-copy">
          <p class="about-role">{about.intro.role}</p>
          <h2>{about.summary.title}</h2>
          <p>{about.summary.description}</p>
        </div>
      </div>

      <div class="about-contact-card">
        <SectionHeader
          eyebrow={about.contact.eyebrow}
          title={about.contact.title}
          description={about.contact.description}
        />
        <div class="about-contact-links">
          {siteConfig.contactLinks.map((link) => (
            <a
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noreferrer' : undefined}
              class="about-contact-link"
            >
              {link.label[locale]}
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="about-section">
      <SectionHeader
        eyebrow={about.values.eyebrow}
        title={about.values.title}
        description={about.values.description}
      />
      <div class="about-grid about-grid-three">
        {about.values.items.map((item) => (
          <article class="about-card">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="about-section">
      <SectionHeader
        eyebrow={about.interests.eyebrow}
        title={about.interests.title}
        description={about.interests.description}
      />
      <div class="about-grid">
        {about.interests.items.map((item) => (
          <article class="about-card">
            <h3>{item.title}</h3>
            <ul>
              {item.points.map((point) => <li>{point}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>
  </PageContainer>
</Main>

<style>
  .about-page {
    display: grid;
    gap: 2rem;
    padding-top: 2rem;
    padding-bottom: 3rem;
  }

  .about-intro {
    max-width: 48rem;
  }

  .about-hero {
    display: grid;
    gap: 1rem;
  }

  .about-profile-card,
  .about-contact-card,
  .about-card {
    border: 1px solid var(--surface-border);
    background: var(--surface-bg-strong);
    box-shadow: var(--shadow-soft);
  }

  .about-profile-card {
    display: grid;
    gap: 1.2rem;
    padding: 1.2rem;
  }

  .about-avatar {
    width: 6.5rem;
    height: 6.5rem;
    border-radius: 999px;
    object-fit: cover;
    border: 1px solid var(--surface-border);
  }

  .about-profile-copy {
    display: grid;
    gap: 0.8rem;
  }

  .about-profile-copy h2,
  .about-card h3 {
    margin: 0;
    color: var(--text-strong);
  }

  .about-profile-copy p,
  .about-card p,
  .about-card li {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.8;
  }

  .about-role {
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .about-contact-card {
    display: grid;
    gap: 1rem;
    padding: 1.2rem;
  }

  .about-contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .about-contact-link {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--surface-border);
    padding: 0.7rem 1rem;
    color: var(--text-strong);
    text-decoration: none;
    transition: border-color 180ms ease, transform 180ms ease, background-color 180ms ease;
  }

  .about-contact-link:hover {
    border-color: rgba(31, 118, 103, 0.26);
    background: var(--accent-soft);
    transform: translateY(-1px);
  }

  .about-section {
    display: grid;
    gap: 1rem;
  }

  .about-grid {
    display: grid;
    gap: 1rem;
  }

  .about-card {
    display: grid;
    gap: 0.8rem;
    padding: 1.2rem;
  }

  .about-card ul {
    display: grid;
    gap: 0.7rem;
    margin: 0;
    padding-left: 1.2rem;
  }

  @media (min-width: 768px) {
    .about-page {
      gap: 2.5rem;
      padding-top: 2.5rem;
    }

    .about-grid-three {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .about-hero {
      grid-template-columns: minmax(0, 1.25fr) minmax(19rem, 0.75fr);
      align-items: start;
    }

    .about-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
