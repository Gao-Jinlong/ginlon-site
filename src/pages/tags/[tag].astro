---
import { type AppLocale } from '../../i18n/utils';
import { getAllTags } from '../../utils/getTags';

interface Props {
  tagName?: string;
}

export async function getStaticPaths() {
  const locale: AppLocale = 'zh';
  const tags = await getAllTags(locale);

  return tags.map((tag) => ({
    params: { tag: tag.slug },
    props: { tagName: tag.name },
  }));
}

return Astro.redirect(
  `/writing?tag=${encodeURIComponent((Astro.props as Props).tagName ?? Astro.params.tag ?? '')}`,
);
---
