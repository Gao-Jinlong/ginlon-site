---
import BlogCard from '../../components/BlogCard.astro';
import PageContainer from '../../components/PageContainer.astro';
import PageIntro from '../../components/PageIntro.astro';
import Main from '../../layouts/Main.astro';
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../../i18n/utils';
import { getBlogsByTag } from '../../utils/getTags';
import { getTagStaticPaths } from '../../utils/tagStaticPaths';

export async function getStaticPaths() {
  return getTagStaticPaths('zh');
}

const { tagName } = Astro.props as { tagName: string };
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const blogs = await getBlogsByTag(tagName, locale);
const pageMeta =
  locale === 'zh'
    ? {
        title: `标签：${tagName}`,
        description: `查看和“${tagName}”相关的文章与笔记。`,
      }
    : {
        title: `Tag: ${tagName}`,
        description: `Read articles and notes related to ${tagName}.`,
      };
---

<Main pageMeta={pageMeta}>
  <PageContainer class="tag-detail-page">
    <PageIntro
      eyebrow={t('tags.eyebrow')}
      title={`# ${tagName}`}
      description={locale === 'zh' ? `共 ${blogs.length} 篇相关文章` : `${blogs.length} related articles`}
    />

    {blogs.length > 0 ? (
      <section class="tag-results">
        {blogs.map((blog) => (
          <BlogCard blog={blog} />
        ))}
      </section>
    ) : (
      <section class="tag-empty">
        <p>{t('tags.emptyTitle')}</p>
        <a href={getLocalizedPath(locale, 'blogs')}>{t('tags.backToBlogs')}</a>
      </section>
    )}
  </PageContainer>
</Main>

<style>
  .tag-detail-page {
    display: grid;
    gap: 2rem;
    padding-top: 2rem;
    padding-bottom: 3rem;
  }

  .tag-results {
    display: grid;
    gap: 1rem;
  }

  .tag-empty {
    display: grid;
    gap: 0.8rem;
    justify-items: start;
    border: 1px solid var(--surface-border);
    background: var(--surface-bg-strong);
    padding: 1.2rem;
    box-shadow: var(--shadow-soft);
  }

  .tag-empty p,
  .tag-empty a {
    margin: 0;
  }

  .tag-empty p {
    color: var(--text-muted);
    line-height: 1.8;
  }

  .tag-empty a {
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
  }
</style>
