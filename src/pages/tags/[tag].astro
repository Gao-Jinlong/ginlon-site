---
import Main from '../../layouts/Main.astro';
import { getBlogsByTag, getAllTags, type Tag } from '../../utils/getTags';
import BlogCard from '../../components/BlogCard.astro';
import { getLocaleFromUrl, getLocalizedPath, type AppLocale } from '../../i18n/utils';

export async function getStaticPaths() {
  const locale: AppLocale = 'zh';
  const tags = await getAllTags(locale);

  return tags.map((tag) => ({
    params: { tag: tag.slug },
    props: { tagName: tag.name },
  }));
}

interface Props {
  tagName: string;
}

const { tagName } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const blogs = await getBlogsByTag(tagName, locale);
---

<Main pageTitle={`标签: ${tagName}`}>
  <section class="tag-page">
    <div class="tag-header">
      <h1 class="tag-title">
        <span class="tag-icon">#</span>
        <span class="tag-name">{tagName}</span>
      </h1>
      <p class="tag-count">
        共找到 {blogs.length} 篇文章
      </p>
    </div>

    {blogs.length > 0 ? (
      <div class="blog-list">
        {blogs.map(blog => (
          <BlogCard blog={blog} />
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <p>该标签下暂无文章</p>
        <a href={getLocalizedPath(locale, 'blogs')} class="back-link">返回博客列表</a>
      </div>
    )}
  </section>
</Main>

<style>
  @reference "../../styles/styles.css";

  .tag-page {
    @apply mx-auto;
    @apply max-w-4xl lg:max-w-5xl xl:max-w-6xl;
    @apply py-8;
  }

  .tag-header {
    @apply mb-8;
  }

  .tag-title {
    @apply mb-2 flex items-center gap-2 text-3xl font-bold;
    @apply text-gray-900 dark:text-gray-100;
  }

  .tag-icon {
    @apply text-blue-500 dark:text-blue-400;
  }

  .tag-name {
    @apply bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent;
    @apply dark:from-blue-400 dark:to-purple-400;
  }

  .tag-count {
    @apply text-gray-600 dark:text-gray-400;
    @apply text-lg;
  }

  .blog-list {
    @apply grid gap-6;
    @apply grid-cols-1;
  }

  .empty-state {
    @apply text-center py-12;
  }

  .empty-state p {
    @apply mb-4 text-xl text-gray-600 dark:text-gray-400;
  }

  .back-link {
    @apply inline-block text-blue-600 hover:text-blue-800;
    @apply dark:text-blue-400 dark:hover:text-blue-300;
    @apply font-medium;
  }
</style>
