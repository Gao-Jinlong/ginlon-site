---
import PageContainer from '../../components/PageContainer.astro';
import PageIntro from '../../components/PageIntro.astro';
import { getAllTags } from '../../utils/getTags';
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../../i18n/utils';
import Main from '../../layouts/Main.astro';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const tags = await getAllTags(locale);
const pageMeta =
  locale === 'zh'
    ? {
        title: '标签索引',
        description: '通过标签浏览 Ginlon 的写作主题与相关文章。',
      }
    : {
        title: 'Tag Index',
        description: "Browse Ginlon's writing by recurring topics and themes.",
      };
---

<Main pageMeta={pageMeta}>
  <PageContainer class="tags-page">
    <PageIntro eyebrow={t('tags.eyebrow')} title={t('tags.title')} description={t('tags.description')} />

    <section class="tags-grid">
      {tags.map((tag) => (
        <a href={getLocalizedPath(locale, `tags/${tag.slug}`)} class="tag-card">
          <div class="tag-card-top">
            <span class="tag-mark">#</span>
            <h2>{tag.name}</h2>
          </div>
          <p>{locale === 'zh' ? `${tag.count} 篇文章` : `${tag.count} articles`}</p>
        </a>
      ))}
    </section>
  </PageContainer>
</Main>

<style>
  .tags-page {
    display: grid;
    gap: 2rem;
    padding-top: 2rem;
    padding-bottom: 3rem;
  }

  .tags-grid {
    display: grid;
    gap: 1rem;
  }

  .tag-card {
    display: grid;
    gap: 0.8rem;
    border: 1px solid var(--surface-border);
    background: var(--surface-bg-strong);
    padding: 1rem;
    color: inherit;
    text-decoration: none;
    box-shadow: var(--shadow-soft);
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .tag-card:hover {
    transform: translateY(-2px);
    border-color: rgba(31, 118, 103, 0.26);
    box-shadow: 0 20px 36px rgba(15, 23, 42, 0.08);
  }

  .tag-card-top {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .tag-mark {
    color: var(--accent);
    font-size: 1rem;
    font-weight: 700;
  }

  .tag-card h2,
  .tag-card p {
    margin: 0;
  }

  .tag-card h2 {
    color: var(--text-strong);
    font-size: 1.08rem;
    line-height: 1.3;
  }

  .tag-card p {
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  @media (min-width: 640px) {
    .tags-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .tags-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
